<div class="modal fade" id="<%= modal_id %>" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title"><%= modal_title %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <%= form_with model: form_object, url: form_url, local: true do |f| %>
        <div class="modal-body">

          <%= f.hidden_field :phase_step_id, id: "modal_phase_step_id" %>

          <div class="mb-3">
            <label class="form-label">Action Type</label>
            <%= f.select :action_type,
                         StepAction.action_types.keys.map { |k| [k.humanize, k] },
                         {},
                         class: "form-select" %>
          </div>

          <div class="mb-3">
            <label class="form-label">Instruction</label>
            <%= f.text_area :instruction, class: "form-control" %>
          </div>

          <div class="mb-3">
            <label class="form-label">Position</label>
            <%= f.number_field :position, class: "form-control", min: 1 %>
          </div>

        </div>

        <div class="modal-footer">
          <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-primary">Save Action</button>
        </div>

      <% end %>

    </div>
  </div>
</div>