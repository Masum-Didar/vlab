<header class="bg-white border-bottom border-secondary sticky-top z-2 d-flex align-items-center justify-content-between px-4" style="height: 4rem;">
  <div class="d-flex align-items-center gap-3">
    <button type="button" class="btn btn-light border-0 p-2 d-md-none" aria-label="Toggle sidebar" data-action="click->sidebar#toggle">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></path></svg>
    </button>
    <h1 class="h5 fw-semibold text-body mb-0"><%= content_for?(:title) ? yield(:title) : "Admin Dashboard" %></h1>
  </div>
  <% if user_signed_in? %>
    <div class="d-flex align-items-center gap-3">
      <%= link_to user_path(current_user), class: "d-flex align-items-center gap-2 text-decoration-none text-body" do %>
        <div class="text-end d-none d-sm-block">
          <p class="small fw-medium mb-0 text-dark"><%= current_user.full_name %></p>
          <p class="small text-body-secondary mb-0"><%= current_user.role_title %></p>
        </div>
        <div class="rounded-circle bg-primary bg-opacity-25 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 2.5rem; height: 2.5rem;"><%= current_user.initials %></div>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, data: { turbo: false }, class: "btn btn-outline-danger btn-sm p-2", title: "Sign Out" do %>
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2h4a2 2 0 012 2v1"/></svg>
      <% end %>
    </div>
  <% end %>
</header>
