<aside id="sidebar" class="bg-white border-end border-secondary flex-column position-fixed h-100 z-3">
  <div class="d-flex align-items-center justify-content-between px-4 border-bottom border-light" style="height: 4rem;">
    <%= link_to super_admin_dashboard_path, class: "d-flex align-items-center gap-2 text-danger text-decoration-none" do %>
      <svg class="flex-shrink-0" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
      <h2 class="h5 fw-bold mb-0">Super Admin</h2>
    <% end %>
  </div>
  <nav class="flex-grow-1 px-3 py-4 overflow-auto">
    <% links = [
      { name: 'Dashboard', path: super_admin_dashboard_path, icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" },
      { name: 'Schools', path: super_admin_schools_path, icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" },
      { name: 'Experiments', path: super_admin_experiments_path, icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" },
      { name: 'Equipments', path: super_admin_equipments_path, icon: "M9 3h6m-3 0v4m-5 4h10m-8 0v8m6-8v8M5 21h14" },
      { name: 'Chemicals', path: super_admin_chemicals_path, icon: "M9 12h6m-3-3v6m6 2a9 9 0 11-12 0 9 9 0 0112 0z" },
      { name: 'Containers', path: super_admin_containers_path, icon: "M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6m16 0H4" },
      { name: 'Admins', path: super_admin_admins_path, icon: "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" }
    ] %>
    <div class="d-flex flex-column gap-1">
      <% links.each do |link| %>
        <%= link_to link[:path], class: "d-flex align-items-center gap-3 px-3 py-2 rounded text-decoration-none #{current_page?(link[:path]) ? 'bg-danger bg-opacity-10 text-danger fw-medium' : 'text-body-secondary'}" do %>
          <svg class="flex-shrink-0" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= link[:icon] %>"></path></svg>
          <%= link[:name] %>
        <% end %>
      <% end %>
    </div>
  </nav>
</aside>
