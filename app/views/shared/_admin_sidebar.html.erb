<aside id="sidebar" class="bg-white border-end border-secondary flex-column position-fixed h-100 z-3">
  <div class="d-flex align-items-center justify-content-between px-4 border-bottom border-light" style="height: 4rem;">
    <%= link_to admin_dashboard_path, class: "d-flex align-items-center gap-2 text-primary text-decoration-none" do %>
      <svg class="flex-shrink-0" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
      <h2 class="h5 fw-bold mb-0">VLab Admin</h2>
    <% end %>
    <button type="button" class="btn btn-light border-0 p-2 d-md-none" aria-label="Close sidebar" data-action="click->sidebar#close">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>
  <nav class="flex-grow-1 px-3 py-4 overflow-auto">
    <% admin_links = [
      { name: 'Dashboard', path: admin_dashboard_path, icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" },
      { name: 'Experiments', path: admin_experiments_path, icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" },
      { name: 'Equipments', path: admin_equipments_path, icon: "M9 3h6m-3 0v4m-5 4h10m-8 0v8m6-8v8M5 21h14" },
      { name: 'Chemicals', path: admin_chemicals_path, icon: "M9 12h6m-3-3v6m6 2a9 9 0 11-12 0 9 9 0 0112 0z" },
      { name: 'Containers', path: admin_containers_path, icon: "M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6m16 0H4" },
      { name: 'Faculty Approvals', path: admin_faculty_index_path, icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" },
      { name: 'Users', path: users_path, icon: "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" },
      { name: 'Submissions', path: submissions_path, icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" }
    ] %>
    <div class="d-flex flex-column gap-1">
      <% admin_links.each do |link| %>
        <%= link_to link[:path], class: "d-flex align-items-center gap-3 px-3 py-2 rounded text-decoration-none #{current_page?(link[:path]) ? 'bg-primary bg-opacity-10 text-primary fw-medium' : 'text-body-secondary'}" do %>
          <svg class="flex-shrink-0" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= link[:icon] %>"></path></svg>
          <%= link[:name] %>
        <% end %>
      <% end %>
    </div>
  </nav>
  <div class="p-3 border-top d-md-none">
    <% if user_signed_in? %>
      <%= button_to "Sign Out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "btn btn-outline-danger btn-sm w-100" %>
    <% end %>
  </div>
</aside>
