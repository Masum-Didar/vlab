<aside id="sidebar" class="bg-white border-end border-secondary flex-column position-fixed h-100 z-3">
  <div class="d-flex align-items-center justify-content-between px-4 border-bottom border-light" style="height: 4rem;">
    <%= link_to root_path, class: "d-flex align-items-center gap-2 text-primary text-decoration-none" do %>
      <svg class="flex-shrink-0" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
      <h2 class="h5 fw-bold mb-0">VLab</h2>
    <% end %>
    <button type="button" class="btn btn-light border-0 p-2 d-md-none" aria-label="Close sidebar" data-action="click->sidebar#close">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>
  <nav class="flex-grow-1 px-3 py-4 overflow-auto">
    <% student_links = [
      { name: 'Dashboard', path: dashboard_path, icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" },
      { name: 'Experiments', path: experiments_path, icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" },
      { name: 'My Lab Sessions', path: lab_sessions_path, icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" },
      { name: 'My Submissions', path: submissions_path, icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" },
      { name: 'My Results', path: experiment_results_path, icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" }
    ] %>
    <div class="d-flex flex-column gap-1">
      <% student_links.each do |link| %>
        <%= link_to link[:path], class: "d-flex align-items-center gap-3 px-3 py-2 rounded text-decoration-none #{current_page?(link[:path]) ? 'bg-primary bg-opacity-10 text-primary fw-medium' : 'text-body-secondary'}" do %>
          <svg class="flex-shrink-0" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= link[:icon] %>"></path></svg>
          <%= link[:name] %>
        <% end %>
      <% end %>
    </div>
  </nav>
  <div class="p-3 border-top d-md-none">
    <% if user_signed_in? %>
      <div class="d-flex align-items-center gap-2 mb-2">
        <div class="rounded-circle bg-primary bg-opacity-25 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 2.5rem; height: 2.5rem;"><%= current_user.initials %></div>
        <div>
          <p class="small fw-medium mb-0"><%= current_user.full_name %></p>
          <p class="small text-body-secondary mb-0">Student</p>
        </div>
      </div>
      <%= button_to "Sign Out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "btn btn-outline-danger btn-sm w-100" %>
    <% end %>
  </div>
</aside>
