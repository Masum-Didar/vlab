<% flash.each do |key, value| %>
  <%
    color_class = case key.to_s
                  when 'notice' then 'bg-green-100 text-green-800 border-green-200'
                  when 'alert' then 'bg-red-100 text-red-800 border-red-200'
                  else 'bg-blue-100 text-blue-800 border-blue-200'
                  end
  %>
  <div class="<%= color_class %> border px-4 py-3 rounded mb-4 text-sm">
    <%= value %>
  </div>
<% end %>