<!DOCTYPE html>
<html>

<head>
  <title>Admin Panel</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
</head>

<body class="bg-gray-100 min-h-screen flex">

<!-- Sidebar -->
<aside class="w-64 bg-white shadow-md hidden md:flex flex-col">
  <div class="p-6 border-b">
    <h1 class="text-xl font-semibold">Admin Panel</h1>
  </div>

  <nav class="flex-1 p-4 space-y-2">
    <%= link_to "Dashboard", admin_dashboard_path, class: "block px-4 py-2 rounded-lg hover:bg-gray-200" %>
    <%= link_to "Experiments", admin_experiments_path, class: "block px-4 py-2 rounded-lg hover:bg-gray-200" %>
    <%#= link_to "Users", admin_users_path, class: "block px-4 py-2 rounded-lg hover:bg-gray-200" %>
  </nav>

  <div class="p-4 border-t">
    <%#= link_to "Logout", destroy_user_session_path, method: :delete, class: "text-red-600 font-medium" %>
    <%= button_to destroy_user_session_path,
                  method: :delete,
                  data: { turbo: false },
                  class: "p-2 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 transition",title: "Sign Out" do %>

      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2h4a2 2 0 012 2v1"/>
      </svg>
    <% end %>
  </div>
</aside>

<!-- Main -->
<div class="flex-1 flex flex-col">

  <!-- Top Bar -->
  <header class="w-full bg-white shadow-sm p-4 flex items-center justify-between">
    <h2 class="text-lg font-semibold">
      <%= content_for?(:title) ? yield(:title) : "Admin" %>
    </h2>

    <div class="flex items-center space-x-4">
      <span class="text-gray-600"><%= current_user.email %></span>
    </div>
  </header>

  <!-- Page Content -->
  <main class="p-6">
    <%= yield %>
  </main>

</div>

</body>
</html>
