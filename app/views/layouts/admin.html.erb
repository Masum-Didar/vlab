<!DOCTYPE html>
<html>
<head>
  <title><%= content_for?(:title) ? "#{current_user&.administrator? ? "Admin" : "Faculty"} | #{yield(:title)}" : (current_user&.administrator? ? "Admin Panel" : "Faculty Panel") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
</head>

<body class="min-vh-100 bg-light d-flex">
<div data-controller="alert" class="lab-toast-container"></div>

<!-- 1. The Admin / Faculty Sidebar -->
<%= render current_user&.administrator? ? "shared/admin_sidebar" : "shared/faculty_sidebar" %>

<!-- Overlay when sidebar is open (click to close) -->
<div id="sidebar-overlay" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-25 z-2 d-none" style="cursor: pointer;" data-action="click->sidebar#close" aria-hidden="true"></div>

<!-- 2. The Main Content Wrapper -->
<main id="main-content" class="flex-grow-1 flex-column h-100 overflow-hidden ms-sidebar">

  <!-- A. The Admin Navbar -->
  <%= render "shared/admin_navbar" %>

  <!-- B. The Page Content -->
  <div class="flex-grow-1 overflow-auto p-4">
    <!-- Flash Messages can be rendered here if needed -->
    <%= render "shared/flash" %>

    <%= yield %>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
