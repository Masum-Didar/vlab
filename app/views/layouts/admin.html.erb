<!DOCTYPE html>
<html>
<head>
  <title>Admin Panel</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
</head>
<body class="bg-light min-vh-100 d-flex">
  <aside class="bg-white shadow-sm flex-column d-none d-md-flex" style="width: 16rem;">
    <div class="p-4 border-bottom">
      <h1 class="h6 fw-semibold mb-0">Admin Panel</h1>
    </div>
    <nav class="flex-grow-1 p-3">
      <%= link_to "Dashboard", admin_dashboard_path, class: "d-block px-3 py-2 rounded text-decoration-none text-body" %>
      <%= link_to "Experiments", admin_experiments_path, class: "d-block px-3 py-2 rounded text-decoration-none text-body" %>
      <%= link_to "Chemicals", admin_chemicals_path, class: "d-block px-3 py-2 rounded text-decoration-none text-body" %>
      <%= link_to "Equipments", admin_equipments_path, class: "d-block px-3 py-2 rounded text-decoration-none text-body" %>

    </nav>
    <div class="p-3 border-top">
      <%= button_to destroy_user_session_path, method: :delete, data: { turbo: false }, class: "btn btn-outline-danger btn-sm p-2", title: "Sign Out" do %>
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2h4a2 2 0 012 2v1"/></svg>
      <% end %>
    </div>
  </aside>
  <div class="flex-grow-1 d-flex flex-column">
    <header class="bg-white shadow-sm p-4 d-flex align-items-center justify-content-between">
      <h2 class="h6 fw-semibold mb-0"><%= content_for?(:title) ? yield(:title) : "Admin" %></h2>
      <span class="text-body-secondary small"><%= current_user.email %></span>
    </header>
    <main class="p-4"><%= yield %></main>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
