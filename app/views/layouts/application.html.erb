<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Vlab" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
</head>

<body class="min-h-screen bg-gray-100 flex font-sans">
<% if user_signed_in? %>

  <!-- 1. The Fixed Sidebar -->
  <%= render "shared/sidebar" %>

  <!-- 2. The Main Content Wrapper -->
  <main class="flex-1 ml-64 flex flex-col h-screen overflow-hidden">

    <!-- A. The Navbar -->
    <%= render "shared/navbar" %>

    <!-- B. The Page Content -->
    <div class="flex-1 overflow-y-auto p-8">
      <!-- Suggestion: Render Flash Messages here -->
      <%= render "shared/flash"%>

      <%= yield %>
    </div>
  </main>

<% else %>

  <!-- Login / Signup Layout -->
  <!-- Added w-full to ensure perfect centering -->
  <main class="w-full min-h-screen flex flex-col items-center justify-center p-4">
    <!-- Flash messages for login errors -->
    <%= render "shared/flash" %>

    <%= yield %>
  </main>

<% end %>
</body>
</html>
