<%
  action = step.step_actions.first
  config = action&.config || {}
  substep = config["substep"]
  timer_duration = step.timer_duration || 0
%>

<div class="gel-prep"
     data-controller="gel-prep"
     data-gel-prep-substep-value="<%= substep %>"
     data-gel-prep-timer-duration-value="<%= timer_duration %>">
  
  <div class="gel-prep__visual mb-3">
    <div class="gel-prep__tray <%= 'is-placed' if ['tray', 'tape', 'comb', 'etbr', 'pour', 'solidify', 'remove_comb', 'buffer'].include?(substep) %>" data-gel-prep-target="tray">
      <div class="gel-prep__tray-body">
        
        <!-- Tape visual -->
        <div class="gel-prep__tape gel-prep__tape--left <%= 'is-applied' if ['tape', 'comb', 'etbr', 'pour', 'solidify', 'remove_comb', 'buffer'].include?(substep) %>" data-gel-prep-target="tapeLeft"></div>
        <div class="gel-prep__tape gel-prep__tape--right <%= 'is-applied' if ['tape', 'comb', 'etbr', 'pour', 'solidify', 'remove_comb', 'buffer'].include?(substep) %>" data-gel-prep-target="tapeRight"></div>

        <!-- Comb visual -->
        <div class="gel-prep__comb <%= 'is-inserted' if ['comb', 'etbr', 'pour', 'solidify'].include?(substep) %>" data-gel-prep-target="comb">
          <div class="gel-prep__comb-teeth">
            <% 5.times do %><span></span><% end %>
          </div>
        </div>

        <!-- Gel visual -->
        <div class="gel-prep__gel <%= 'is-poured' if ['pour', 'solidify', 'remove_comb', 'buffer'].include?(substep) %> <%= 'is-solidified' if ['solidify', 'remove_comb', 'buffer'].include?(substep) %>" data-gel-prep-target="gel">
          <div class="gel-prep__gel-surface"></div>
        </div>

        <!-- Wells visual -->
        <div class="gel-prep__wells <%= 'is-visible' if ['remove_comb', 'buffer'].include?(substep) %>" data-gel-prep-target="wells">
          <% 5.times do |i| %>
            <div class="gel-prep__well"></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="gel-prep__interactive">
    <% case substep %>
    <% when "tray" %>
      <div class="d-flex flex-column gap-2">
        <p class="text-body-secondary small">Place the clean gel casting tray on the workbench level surface.</p>
        <button type="button" class="btn btn-primary btn-sm w-100" data-action="click->gel-prep#performAction" data-gel-prep-target="actionButton">
          Place Casting Tray
        </button>
      </div>
    <% when "tape" %>
      <div class="d-flex flex-column gap-2">
        <p class="text-body-secondary small">Apply masking tape to both open ends of the casting tray to prevent liquid agarose from leaking out.</p>
        <button type="button" class="btn btn-primary btn-sm w-100" data-action="click->gel-prep#performAction" data-gel-prep-target="actionButton">
          Apply Masking Tape
        </button>
      </div>
    <% when "comb" %>
      <div class="d-flex flex-column gap-2">
        <p class="text-body-secondary small">Insert the gel comb into the slots near one end of the tray to create wells for loading DNA samples.</p>
        <button type="button" class="btn btn-primary btn-sm w-100" data-action="click->gel-prep#performAction" data-gel-prep-target="actionButton">
          Insert Gel Comb
        </button>
      </div>
    <% when "etbr" %>
      <div class="d-flex flex-column gap-2 p-3 border border-warning bg-warning bg-opacity-10 rounded text-warning-emphasis">
        <h6 class="small fw-bold mb-1">⚠️ Safety Warning: Ethidium Bromide</h6>
        <p class="x-small mb-2">Ethidium Bromide (EtBr) is a powerful mutagen and moderate toxin. Always wear nitrile gloves, laboratory coat, and protective eyewear.</p>
        <button type="button" class="btn btn-warning btn-sm w-100 fw-bold" data-action="click->gel-prep#performAction" data-gel-prep-target="actionButton">
          Add Ethidium Bromide (1.5 µL)
        </button>
      </div>
    <% when "pour" %>
      <div class="d-flex flex-column gap-2">
        <p class="text-body-secondary small">Pour the warm agarose solution containing EtBr slowly into the sealed casting tray.</p>
        <button type="button" class="btn btn-primary btn-sm w-100" data-action="click->gel-prep#performAction" data-gel-prep-target="actionButton">
          Pour Agarose Gel
        </button>
      </div>
    <% when "solidify" %>
      <div class="d-flex flex-column gap-2">
        <p class="text-body-secondary small">Let the gel cool and solidify at room temperature for approximately 10 minutes.</p>
        
        <div class="d-flex align-items-center justify-content-center gap-2 my-2 py-2 border rounded bg-light">
          <span class="fs-4 fw-mono text-primary" data-gel-prep-target="timerDisplay">10:00</span>
        </div>

        <button type="button" class="btn btn-primary btn-sm w-100" data-action="click->gel-prep#startSolidification" data-gel-prep-target="actionButton">
          Start Solidification Timer
        </button>
      </div>
    <% when "remove_comb" %>
      <div class="d-flex flex-column gap-2">
        <p class="text-body-secondary small">Carefully pull the comb straight up out of the solidified gel, and remove the masking tape from both ends.</p>
        <button type="button" class="btn btn-primary btn-sm w-100" data-action="click->gel-prep#performAction" data-gel-prep-target="actionButton">
          Remove Comb & Tape
        </button>
      </div>
    <% when "buffer" %>
      <div class="d-flex flex-column gap-2">
        <p class="text-body-secondary small">Place the gel into the chamber and cover it completely with 1x TAE buffer solution.</p>
        <button type="button" class="btn btn-primary btn-sm w-100" data-action="click->gel-prep#performAction" data-gel-prep-target="actionButton">
          Pour 1x TAE Buffer
        </button>
      </div>
    <% end %>
  </div>

  <input type="hidden" name="gel_prep_data" data-gel-prep-target="input" data-action-input>
</div>
