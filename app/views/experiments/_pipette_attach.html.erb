<div class="pipette-tip mt-2 p-2 border rounded bg-light d-flex align-items-center gap-2"
     data-controller="pipette"
     data-pipette-mode-value="attach">
  <button type="button"
          class="btn btn-success btn-sm"
          data-action="click->pipette#attach">
    Attach tip
  </button>
  <span class="badge text-bg-secondary" data-pipette-target="statusText">No tip</span>
  <input type="hidden" name="pipette_state" data-pipette-target="input" data-action-input="true" value="">
</div>
