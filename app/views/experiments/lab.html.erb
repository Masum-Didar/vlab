<% content_for :title, "#{@experiment.title} - Lab" %>

<div class="student-lab"
     data-controller="lab"
     data-lab-experiment-id-value="<%= @experiment.id %>"
     data-lab-current-phase-value="<%= @lab_session.current_phase %>"
      data-lab-completed-phases-value="<%= @lab_session.completed_phases&.to_json || '[]' %>"
      data-lab-total-phases-value="<%= @experiment.experiment_phases.size %>">
  <header class="student-lab-head">
    <div>
      <h1><%= @experiment.title %></h1>
      <p>Complete each phase in order.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <span class="badge text-bg-light border text-dark">Phase <%= @lab_session.current_phase %> of <%= @experiment.experiment_phases.size %></span>
      <%= link_to "Exit lab", experiments_path, class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </header>

  <div class="student-lab__workspace">
    <section class="student-lab__stage">
      <div class="student-lab__bench">
        <div class="student-lab__shelf"></div>
        <div class="student-lab__item student-lab__item--buffer">Buffer</div>
        <div class="student-lab__item student-lab__item--chamber">Chamber</div>
        <div class="student-lab__item student-lab__item--samples">DNA Samples</div>
        <div class="student-lab__item student-lab__item--power">70 V</div>
        <div class="student-lab__item student-lab__item--uv">UV Table</div>
        <div class="student-lab__item student-lab__item--pipette">Micropipette</div>
        <div class="student-lab__item student-lab__item--tray">Casting Tray</div>
        <div class="student-lab__item student-lab__item--flask">Flask</div>
        <div class="student-lab__item student-lab__item--comb">Comb</div>
      </div>
    </section>

    <aside class="student-lab__panel">
      <div class="student-lab__materials">
        <span class="badge text-bg-light border text-dark">Interactive lab flow</span>
      </div>

      <% @experiment.experiment_phases.each_with_index do |phase, index| %>
        <section class="student-lab__phase <%= "is-active" if index.zero? %>"
                 data-lab-target="phasePanel"
                 data-phase-index="<%= index %>">
          <p>Phase <%= phase.position %></p>
          <h2><%= phase.title %></h2>
          <span><%= phase.description %></span>
          <ol>
            <% phase.phase_steps.each do |step| %>
              <li data-step-id="<%= step.id %>"
                  data-phase-index="<%= index %>"
                  data-step-number="<%= step.step_number %>"
                  data-action-type="<%= step.step_actions.first&.action_type %>">
                <label>
                  <input type="checkbox"
                         data-lab-target="stepCheckbox"
                         data-action="change->lab#completeStep"
                         <%= "checked" if @lab_session.phase_completed?(phase.position) %>>
                  <span>
                    <%= step.instruction %>
                    <% step.step_actions.each do |action| %>
                      <small class="student-lab__action"><%= action.action_type.humanize %>: <%= student_action_hint(action) %></small>
                    <% end %>
                  </span>
                </label>
                <% case step.step_actions.first&.action_type
                   when "voltage_set" %>
                  <%= render "voltage_input" %>
                <% when "pipette_tip_attach", "pipette_eject", "transfer" %>
                  <%= render "pipette_station" %>
                <% when "gel_band_match" %>
                  <%= render "gel_band_match" %>
                <% when "gel_prep" %>
                  <%= render "gel_prep" %>
                <% when "gel_run" %>
                  <%= render "gel_run" %>
                <% end %>
              </li>
            <% end %>
          </ol>
        </section>
      <% end %>

      <div class="student-lab__nav">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="click->lab#previousPhase">Previous</button>
        <div>
          <% @experiment.experiment_phases.each_with_index do |phase, index| %>
            <button type="button"
                    class="student-lab__dot <%= "is-active" if index.zero? %>"
                    data-lab-target="phaseTab"
                    data-phase-index="<%= index %>"
                    data-action="click->lab#selectPhase"><%= phase.position %></button>
          <% end %>
        </div>
        <button type="button"
                class="btn btn-primary btn-sm"
                data-lab-target="phaseNavNext"
                data-action="click->lab#nextPhase">Next</button>
      </div>
    </aside>

    <section class="student-lab__completion"
             data-lab-target="completionScreen">
      <div class="student-lab__certificate">
        <div class="certificate__ribbon">
          <span>Certificate of Completion</span>
        </div>
        <div class="certificate__body">
          <div class="certificate__icon">&#10003;</div>
          <h2>Congratulations!</h2>
          <p class="certificate__subtitle">You have successfully completed the lab experiment.</p>
          <div class="certificate__student">
            <span class="certificate__student-initials"><%= current_user.initials %></span>
            <span class="certificate__student-name"><%= current_user.full_name %></span>
          </div>
          <div class="certificate__details">
            <div class="certificate__row">
              <span class="certificate__label">Experiment:</span>
              <span class="certificate__value"><%= @experiment.title %></span>
            </div>
            <div class="certificate__row">
              <span class="certificate__label">Completed:</span>
              <span class="certificate__value"><%= Time.current.strftime("%B %d, %Y") %></span>
            </div>
            <div class="certificate__row">
              <span class="certificate__label">Phases:</span>
              <span class="certificate__value"><%= @experiment.experiment_phases.size %> of <%= @experiment.experiment_phases.size %></span>
            </div>
            <div class="certificate__row">
              <span class="certificate__label">Status:</span>
              <span class="certificate__value certificate__value--pass">PASSED</span>
            </div>
          </div>
          <div class="certificate__actions">
            <%= link_to "Back to Dashboard", experiments_path, class: "btn btn-primary" %>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
