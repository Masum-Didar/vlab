<% content_for :title, "Available Experiments" %>

<header class="student-lab-head">
  <div>
    <h1>Available Experiments</h1>
    <p>Start a published lab assigned by your faculty.</p>
  </div>
</header>

<div class="student-experiment-grid">
  <% @experiments.each do |experiment| %>
    <article class="student-experiment-card">
      <div>
        <span class="badge text-bg-success mb-3">Published</span>
        <h2><%= experiment.title %></h2>
        <p><%= truncate(experiment.description, length: 130) %></p>
      </div>
      <div class="student-experiment-card__meta">
        <span><%= experiment.duration.to_i %> min</span>
        <span>Difficulty <%= experiment.difficulty.presence || "N/A" %></span>
        <span><%= pluralize(experiment.experiment_phases.size, "phase") %></span>
      </div>
      <div class="d-flex gap-2">
        <%= link_to "Overview", experiment_path(experiment), class: "btn btn-outline-secondary flex-fill" %>
        <%= link_to "Start Lab", lab_experiment_path(experiment), class: "btn btn-primary flex-fill" %>
      </div>
    </article>
  <% end %>

  <% if @experiments.empty? %>
    <div class="admin-empty w-100">
      <h2>No published experiments</h2>
      <p>Your faculty has not published a lab yet.</p>
    </div>
  <% end %>
</div>
