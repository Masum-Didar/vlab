<header class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">Experiments</h1>
    <p class="text-gray-500 mt-1">Manage lab experiments and their instructions.</p>
  </div>

  <%= link_to new_experiment_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-lg font-medium transition shadow-sm" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    New Experiment
  <% end %>
</header>

<div class="bg-white rounded-xl shadow-sm border border-gray-200">
  <div class="p-6 flex justify-between items-center border-b border-gray-100">
    <input type="text" placeholder="Search experiments..." class="w-64 px-3 py-2 border rounded-lg text-sm">
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
      <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
        <th class="px-6 py-3">Title</th>
<!--        <th class="px-6 py-3">Category</th>-->
        <th class="px-6 py-3">Status</th>
<!--        <th class="px-6 py-3">Total Steps</th>-->
        <th class="px-6 py-3">Created</th>
        <th class="px-6 py-3 text-right">Actions</th>
      </tr>
      </thead>

      <tbody class="divide-y divide-gray-100">
      <% @experiments.each do |exp| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-3 font-medium text-gray-900"><%= exp.title %></td>
          <td class="px-6 py-3 text-gray-600"><%= exp.status %></td>
<!--          <td class="px-6 py-3 text-gray-600"><%#= exp.steps.count %></td>-->
          <td class="px-6 py-3 text-gray-500"><%= exp.created_at.strftime("%b %d, %Y") %></td>
          <td class="px-6 py-3 text-right">
            <div class="flex gap-3 justify-end">
              <%= link_to "Edit", edit_experiment_path(exp), class: "text-indigo-600 hover:text-indigo-800 text-sm" %>
              <%= link_to "Preview", experiment_path(exp), class: "text-gray-500 hover:text-gray-700 text-sm" %>
            </div>
          </td>
        </tr>
      <% end %>

      <% if @experiments.empty? %>
        <tr>
          <td colspan="5" class="px-6 py-8 text-center text-gray-400">No experiments created yet.</td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
