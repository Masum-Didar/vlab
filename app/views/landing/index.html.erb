<div class="container" style="max-width: 42rem;">
  <div class="text-center mb-5">
    <div class="text-primary mb-3">
      <svg width="80" height="80" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mx-auto">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
      </svg>
    </div>
    <h1 class="display-5 fw-bold text-dark mb-3">Welcome to VLab</h1>
    <p class="lead text-body-secondary mb-2">Virtual Laboratory Platform</p>
    <p class="small text-body-secondary">Enter your school's subdomain to get started</p>
  </div>

  <div class="card shadow border-0 overflow-hidden mb-4">
    <div class="card-body p-4">
      <%= form_with url: redirect_to_tenant_path, method: :post, local: true, data: { turbo: false }, html: { class: "d-flex flex-column gap-3" } do |f| %>
        <div>
          <%= f.label :subdomain, "School Subdomain", class: "form-label small fw-medium" %>
          <div class="input-group">
            <%= f.text_field :subdomain, placeholder: "your-school", autofocus: true, required: true, pattern: "[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]", title: "Subdomain can only contain letters, numbers, and hyphens", class: "form-control" %>
            <span class="input-group-text text-body-secondary">.<%= Rails.env.development? ? "lvh.me" : request.domain %></span>
          </div>
          <p class="small text-body-secondary mt-2 mb-0">Enter your school's unique subdomain to access your virtual laboratory</p>
        </div>
        <%= f.submit "Continue", class: "btn btn-primary w-100 fw-semibold" %>
      <% end %>
    </div>
    <div class="card-footer bg-light text-center py-3">
      <p class="small text-body-secondary mb-0">
        Don't have a subdomain?
        <%= link_to "Register your school", new_school_registration_path, class: "fw-medium text-primary text-decoration-none" %>
      </p>
    </div>
  </div>

  <div class="row g-4 text-center">
    <div class="col-12 col-md-4">
      <div class="text-primary mb-2">
        <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mx-auto"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <h3 class="h6 fw-semibold text-dark mb-2">Secure</h3>
      <p class="small text-body-secondary mb-0">Multi-tenant architecture ensures data isolation</p>
    </div>
    <div class="col-12 col-md-4">
      <div class="text-primary mb-2">
        <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mx-auto"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
      </div>
      <h3 class="h6 fw-semibold text-dark mb-2">Fast</h3>
      <p class="small text-body-secondary mb-0">Quick access to your virtual experiments</p>
    </div>
    <div class="col-12 col-md-4">
      <div class="text-primary mb-2">
        <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mx-auto"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
      </div>
      <h3 class="h6 fw-semibold text-dark mb-2">Educational</h3>
      <p class="small text-body-secondary mb-0">Comprehensive virtual laboratory experience</p>
    </div>
  </div>
</div>
