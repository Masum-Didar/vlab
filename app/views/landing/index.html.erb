<div class="w-full max-w-2xl mx-auto">
  <!-- Hero Section -->
  <div class="text-center mb-12">
    <!-- Logo -->
    <div class="flex justify-center mb-6 text-indigo-600">
      <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
      </svg>
    </div>
    
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to VLab</h1>
    <p class="text-xl text-gray-600 mb-2">Virtual Laboratory Platform</p>
    <p class="text-sm text-gray-500">Enter your school's subdomain to get started</p>
  </div>

  <!-- Subdomain Input Form -->
  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
    <div class="px-8 pt-8 pb-6">
      <%= form_with url: redirect_to_tenant_path, method: :post, local: true, data: { turbo: false }, html: { class: "space-y-5" } do |f| %>
        <div>
          <%= f.label :subdomain, "School Subdomain", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="flex items-center">
            <%= f.text_field :subdomain, 
                placeholder: "your-school", 
                autofocus: true,
                class: "block w-full px-3 py-2.5 border border-gray-300 rounded-l-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm",
                required: true,
                pattern: "[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]",
                title: "Subdomain can only contain letters, numbers, and hyphens" %>
            <span class="px-4 py-2.5 bg-gray-100 border border-l-0 border-gray-300 rounded-r-lg text-sm text-gray-600">
              .<%= Rails.env.development? ? "lvh.me" : request.domain %>
            </span>
          </div>
          <p class="mt-2 text-xs text-gray-500">
            Enter your school's unique subdomain to access your virtual laboratory
          </p>
        </div>

        <%= f.submit "Continue", class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer transition-colors" %>
      <% end %>
    </div>

    <!-- Additional Info -->
    <div class="bg-gray-50 px-8 py-4 border-t border-gray-100">
      <p class="text-xs text-gray-600 text-center">
        Don't have a subdomain? 
        <%= link_to "Register your school", new_school_registration_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
      </p>
    </div>
  </div>

  <!-- Features Section (Optional) -->
  <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
    <div class="p-6">
      <div class="text-indigo-600 mb-3">
        <svg class="w-10 h-10 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h3 class="font-semibold text-gray-900 mb-2">Secure</h3>
      <p class="text-sm text-gray-600">Multi-tenant architecture ensures data isolation</p>
    </div>
    
    <div class="p-6">
      <div class="text-indigo-600 mb-3">
        <svg class="w-10 h-10 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </div>
      <h3 class="font-semibold text-gray-900 mb-2">Fast</h3>
      <p class="text-sm text-gray-600">Quick access to your virtual experiments</p>
    </div>
    
    <div class="p-6">
      <div class="text-indigo-600 mb-3">
        <svg class="w-10 h-10 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
      </div>
      <h3 class="font-semibold text-gray-900 mb-2">Educational</h3>
      <p class="text-sm text-gray-600">Comprehensive virtual laboratory experience</p>
    </div>
  </div>
</div>
