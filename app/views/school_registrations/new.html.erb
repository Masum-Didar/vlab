<div class="w-full max-w-2xl mx-auto">
  <!-- Header -->
  <div class="text-center mb-8">
    <div class="flex justify-center mb-4 text-indigo-600">
      <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Register Your School</h1>
    <p class="text-gray-600">Create your school's dedicated VLab space</p>
  </div>

  <!-- Registration Form -->
  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
    <div class="px-8 pt-8 pb-6">
      <%= form_with model: @school_registration, url: school_registrations_path, local: true, html: { class: "space-y-5" } do |f| %>
        
        <% if @school_registration.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@school_registration.errors.count, "error") %> prohibited this registration:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc list-inside space-y-1">
                    <% @school_registration.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- School Information Section -->
        <div class="border-b border-gray-200 pb-5 mb-5">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">School Information</h2>
          
          <div class="space-y-4">
            <!-- School Name -->
            <div>
              <%= f.label :school_name, "School Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :school_name, 
                  autofocus: true,
                  placeholder: "e.g., ABC University",
                  class: "block w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm",
                  required: true %>
            </div>

            <!-- Subdomain -->
            <div>
              <%= f.label :subdomain, "Subdomain", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="flex items-center">
                <%= f.text_field :subdomain, 
                    placeholder: "your-school",
                    class: "block w-full px-3 py-2.5 border border-gray-300 rounded-l-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm",
                    required: true,
                    pattern: "[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]",
                    title: "Subdomain can only contain letters, numbers, and hyphens" %>
                <span class="px-4 py-2.5 bg-gray-100 border border-l-0 border-gray-300 rounded-r-lg text-sm text-gray-600">
                  .<%= Rails.env.development? ? "lvh.me" : request.domain %>
                </span>
              </div>
              <p class="mt-1 text-xs text-gray-500">
                This will be your school's unique URL: <span class="font-mono text-indigo-600">your-subdomain.<%= Rails.env.development? ? "lvh.me" : request.domain %></span>
              </p>
            </div>
          </div>
        </div>

        <!-- Admin Account Section -->
        <div>
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Administrator Account</h2>
          
          <div class="space-y-4">
            <!-- Admin Name -->
            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= f.label :admin_first_name, "First Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_field :admin_first_name, 
                    placeholder: "John",
                    class: "block w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm",
                    required: true %>
              </div>
              <div>
                <%= f.label :admin_last_name, "Last Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_field :admin_last_name, 
                    placeholder: "Doe",
                    class: "block w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm",
                    required: true %>
              </div>
            </div>

            <!-- Admin Email -->
            <div>
              <%= f.label :admin_email, "Email Address", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.email_field :admin_email, 
                  placeholder: "admin@school.edu",
                  autocomplete: "email",
                  class: "block w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm",
                  required: true %>
            </div>

            <!-- Admin Password -->
            <div>
              <%= f.label :admin_password, "Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.password_field :admin_password, 
                  autocomplete: "new-password",
                  placeholder: "Minimum 6 characters",
                  class: "block w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm",
                  required: true %>
              <p class="mt-1 text-xs text-gray-500">Minimum 6 characters</p>
            </div>

            <!-- Admin Password Confirmation -->
            <div>
              <%= f.label :admin_password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.password_field :admin_password_confirmation, 
                  autocomplete: "new-password",
                  placeholder: "Re-enter your password",
                  class: "block w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm",
                  required: true %>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <%= f.submit "Register School", class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer transition-colors" %>
        </div>
      <% end %>
    </div>

    <!-- Footer -->
    <div class="bg-gray-50 px-8 py-4 border-t border-gray-100 text-center">
      <p class="text-xs text-gray-600">
        Already have a school account?
        <%= link_to "Sign in", new_user_session_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
      </p>
    </div>
  </div>

  <!-- Info Box -->
  <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
    <div class="flex">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-blue-800">What happens next?</h3>
        <div class="mt-2 text-sm text-blue-700">
          <ul class="list-disc list-inside space-y-1">
            <li>Your school will be created with a unique subdomain</li>
            <li>You'll be automatically signed in as the administrator</li>
            <li>You'll be redirected to your school's dedicated space</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
