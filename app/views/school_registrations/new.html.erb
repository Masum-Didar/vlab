<div class="container" style="max-width: 42rem;">
  <div class="text-center mb-4">
    <div class="text-primary mb-3">
      <svg width="64" height="64" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mx-auto"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
    </div>
    <h1 class="h2 fw-bold text-dark mb-2">Register Your School</h1>
    <p class="text-body-secondary mb-0">Create your school's dedicated VLab space</p>
  </div>

  <div class="card border shadow-sm overflow-hidden">
    <div class="card-body p-4">
      <%= form_with model: @school_registration, url: school_registrations_path, local: true, html: { class: "d-flex flex-column gap-4" } do |f| %>
        <% if @school_registration.errors.any? %>
          <div class="alert alert-danger d-flex gap-2">
            <div class="flex-shrink-0">!</div>
            <div>
              <strong><%= pluralize(@school_registration.errors.count, "error") %> prohibited this registration:</strong>
              <ul class="mb-0 mt-2 small">
                <% @school_registration.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="border-bottom pb-4">
          <h2 class="h6 fw-semibold text-dark mb-3">School Information</h2>
          <div class="d-flex flex-column gap-3">
            <div>
              <%= f.label :school_name, "School Name", class: "form-label small fw-medium" %>
              <%= f.text_field :school_name, autofocus: true, placeholder: "e.g., ABC University", required: true, class: "form-control" %>
            </div>
            <div>
              <%= f.label :subdomain, "Subdomain", class: "form-label small fw-medium" %>
              <div class="input-group">
                <%= f.text_field :subdomain, placeholder: "your-school", required: true, pattern: "[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]", title: "Subdomain can only contain letters, numbers, and hyphens", class: "form-control" %>
                <span class="input-group-text text-body-secondary">.<%= Rails.env.development? ? "lvh.me" : request.domain %></span>
              </div>
              <p class="small text-body-secondary mt-1 mb-0">This will be your school's unique URL: <span class="font-monospace text-primary">your-subdomain.<%= Rails.env.development? ? "lvh.me" : request.domain %></span></p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="h6 fw-semibold text-dark mb-3">Administrator Account</h2>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <%= f.label :admin_first_name, "First Name", class: "form-label small fw-medium" %>
              <%= f.text_field :admin_first_name, placeholder: "John", required: true, class: "form-control" %>
            </div>
            <div class="col-12 col-md-6">
              <%= f.label :admin_last_name, "Last Name", class: "form-label small fw-medium" %>
              <%= f.text_field :admin_last_name, placeholder: "Doe", required: true, class: "form-control" %>
            </div>
          </div>
          <div class="mt-3">
            <%= f.label :admin_email, "Email Address", class: "form-label small fw-medium" %>
            <%= f.email_field :admin_email, placeholder: "admin@school.edu", autocomplete: "email", required: true, class: "form-control" %>
          </div>
          <div class="mt-3">
            <%= f.label :admin_password, "Password", class: "form-label small fw-medium" %>
            <%= f.password_field :admin_password, autocomplete: "new-password", placeholder: "Minimum 6 characters", required: true, class: "form-control" %>
            <p class="small text-body-secondary mb-0 mt-1">Minimum 6 characters</p>
          </div>
          <div class="mt-3">
            <%= f.label :admin_password_confirmation, "Confirm Password", class: "form-label small fw-medium" %>
            <%= f.password_field :admin_password_confirmation, autocomplete: "new-password", placeholder: "Re-enter your password", required: true, class: "form-control" %>
          </div>
        </div>

        <%= f.submit "Register School", class: "btn btn-primary w-100 fw-semibold" %>
      <% end %>
    </div>
    <div class="card-footer bg-light text-center py-3">
      <p class="small text-body-secondary mb-0">
        Already have a school account?
        <%= link_to "Sign in", new_user_session_path, class: "fw-medium text-primary text-decoration-none" %>
      </p>
    </div>
  </div>

  <div class="alert alert-info mt-4 d-flex gap-2">
    <div class="flex-shrink-0">ℹ</div>
    <div>
      <strong>What happens next?</strong>
      <ul class="mb-0 mt-2 small">
        <li>Your school will be created with a unique subdomain</li>
        <li>You'll be automatically signed in as the administrator</li>
        <li>You'll be redirected to your school's dedicated space</li>
      </ul>
    </div>
  </div>
</div>
