<!-- Header Section -->
<header class="flex justify-between items-start mb-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">Dashboard</h1>
    <p class="text-gray-500 mt-1">Overview of laboratory performance and student progress.</p>
  </div>

  <!-- Quick Action Button -->
  <%= link_to new_experiment_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-lg font-medium transition shadow-sm" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
    New Experiment
  <% end %>
</header>

<!-- STATS GRID -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

  <!-- Students Card -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center gap-4">
    <div class="p-3 rounded-lg bg-blue-50 text-blue-600">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
    </div>
    <div>
      <p class="text-sm font-medium text-gray-500">Total Students</p>
      <p class="text-3xl font-bold text-gray-900"><%= @total_students %></p>
    </div>
  </div>

  <!-- Experiments Card -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center gap-4">
    <div class="p-3 rounded-lg bg-purple-50 text-purple-600">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
    </div>
    <div>
      <p class="text-sm font-medium text-gray-500">Experiments</p>
      <p class="text-3xl font-bold text-gray-900"><%= @total_experiments %></p>
    </div>
  </div>

  <!-- Active Sessions Card -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center gap-4">
    <div class="p-3 rounded-lg bg-emerald-50 text-emerald-600 animate-pulse">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
    </div>
    <div>
      <p class="text-sm font-medium text-gray-500">Active Labs</p>
      <p class="text-3xl font-bold text-gray-900"><%= @active_sessions %></p>
    </div>
  </div>

  <!-- Pending Submissions Card -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center gap-4">
    <div class="p-3 rounded-lg bg-amber-50 text-amber-600">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </div>
    <div>
      <p class="text-sm font-medium text-gray-500">Pending Grade</p>
      <p class="text-3xl font-bold text-gray-900"><%= @pending_submissions %></p>
    </div>
  </div>
</div>

<!-- CONTENT GRID (Table + Quick Access) -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

  <!-- LEFT: Recent Submissions Table -->
  <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center">
      <h3 class="text-lg font-bold text-gray-800">Recent Submissions</h3>
      <%= link_to "View All", submissions_path, class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
        <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider font-semibold">
          <th class="px-6 py-4">Student</th>
          <th class="px-6 py-4">Experiment</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4">Date</th>
          <th class="px-6 py-4">Action</th>
        </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
        <% @recent_submissions.each do |sub| %>
          <tr class="hover:bg-gray-50 transition group">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-bold text-gray-600">
                  <%= sub.user.email.first(2).upcase %>
                </div>
                <span class="font-medium text-gray-900"><%= sub.user.email.split('@').first.capitalize %></span>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-gray-600"><%= sub.experiment.title %></td>
            <td class="px-6 py-4">
              <!-- Using helper class or inline conditional -->
              <span class="px-2.5 py-1 rounded-full text-xs font-medium border <%= status_badge_class(sub.status) %>">
                  <%= sub.status.humanize %>
                </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= sub.created_at.strftime("%b %d, %H:%M") %></td>
            <td class="px-6 py-4">
              <button class="text-gray-400 hover:text-indigo-600 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
              </button>
            </td>
          </tr>
        <% end %>
        <% if @recent_submissions.empty? %>
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-gray-400">No submissions found.</td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- RIGHT: Quick Stats / Visual Placeholder -->
  <div class="flex flex-col gap-6">

    <!-- Visual Chart Placeholder -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
      <h3 class="text-lg font-bold text-gray-800 mb-4">Weekly Activity</h3>
      <div class="h-48 flex items-end justify-between gap-2 px-2">
        <!-- Pure CSS Bars for visual effect -->
        <div class="w-full bg-indigo-100 rounded-t hover:bg-indigo-200 transition relative group" style="height: 40%">
          <div class="opacity-0 group-hover:opacity-100 absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs px-2 py-1 rounded">12</div>
        </div>
        <div class="w-full bg-indigo-100 rounded-t hover:bg-indigo-200 transition relative group" style="height: 65%">
          <div class="opacity-0 group-hover:opacity-100 absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs px-2 py-1 rounded">24</div>
        </div>
        <div class="w-full bg-indigo-100 rounded-t hover:bg-indigo-200 transition relative group" style="height: 45%"></div>
        <div class="w-full bg-indigo-500 rounded-t hover:bg-indigo-600 transition relative group" style="height: 85%">
          <div class="opacity-0 group-hover:opacity-100 absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs px-2 py-1 rounded">Today</div>
        </div>
        <div class="w-full bg-indigo-100 rounded-t hover:bg-indigo-200 transition" style="height: 30%"></div>
        <div class="w-full bg-indigo-100 rounded-t hover:bg-indigo-200 transition" style="height: 50%"></div>
        <div class="w-full bg-indigo-100 rounded-t hover:bg-indigo-200 transition" style="height: 60%"></div>
      </div>
      <div class="flex justify-between mt-2 text-xs text-gray-400">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-indigo-900 p-6 rounded-xl shadow-lg text-white relative overflow-hidden">
      <div class="relative z-10">
        <h3 class="text-lg font-bold mb-2">Lab Controls</h3>
        <p class="text-indigo-200 text-sm mb-4">Quickly manage running sessions.</p>
        <div class="grid grid-cols-2 gap-3">
          <button class="bg-white/10 hover:bg-white/20 border border-white/20 p-2 rounded-lg text-sm transition text-center">
            Broadcast Msg
          </button>
          <button class="bg-white/10 hover:bg-white/20 border border-white/20 p-2 rounded-lg text-sm transition text-center">
            Stop All
          </button>
        </div>
      </div>
      <!-- Decoration -->
      <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 bg-indigo-700 rounded-full blur-3xl opacity-50"></div>
      <div class="absolute bottom-0 left-0 -ml-8 -mb-8 w-32 h-32 bg-purple-700 rounded-full blur-3xl opacity-50"></div>
    </div>
  </div>
</div>


