<header class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h2 fw-bold text-dark">Dashboard</h1>
    <p class="text-body-secondary mb-0 mt-1">Overview of laboratory performance and student progress.</p>
  </div>
  <%= link_to new_experiment_path, class: "btn btn-primary d-inline-flex align-items-center gap-2" do %>
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
    New Experiment
  <% end %>
</header>

<div class="row g-4 mb-4">
  <div class="col-12 col-md-6 col-lg-3">
    <div class="card border shadow-sm h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="p-3 rounded bg-primary bg-opacity-10 text-primary">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
        <div>
          <p class="small text-body-secondary mb-0">Total Students</p>
          <p class="h4 fw-bold mb-0"><%= @total_students %></p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-6 col-lg-3">
    <div class="card border shadow-sm h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="p-3 rounded bg-secondary bg-opacity-10 text-secondary">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
        </div>
        <div>
          <p class="small text-body-secondary mb-0">Experiments</p>
          <p class="h4 fw-bold mb-0"><%= @total_experiments %></p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-6 col-lg-3">
    <div class="card border shadow-sm h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="p-3 rounded bg-success bg-opacity-10 text-success">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </div>
        <div>
          <p class="small text-body-secondary mb-0">Active Labs</p>
          <p class="h4 fw-bold mb-0"><%= @active_sessions %></p>
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-6 col-lg-3">
    <div class="card border shadow-sm h-100">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="p-3 rounded bg-warning bg-opacity-10 text-warning">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
          <p class="small text-body-secondary mb-0">Pending Grade</p>
          <p class="h4 fw-bold mb-0"><%= @pending_submissions %></p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-8">
    <div class="card border shadow-sm">
      <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h3 class="h6 fw-bold mb-0">Recent Submissions</h3>
        <%= link_to "View All", submissions_path, class: "btn btn-link btn-sm text-primary p-0" %>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light text-uppercase small">
            <tr>
              <th class="px-3 py-3">Student</th>
              <th class="px-3 py-3">Experiment</th>
              <th class="px-3 py-3">Status</th>
              <th class="px-3 py-3">Date</th>
              <th class="px-3 py-3">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_submissions.each do |sub| %>
              <tr>
                <td class="px-3 py-3">
                  <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center small fw-bold text-secondary" style="width: 2rem; height: 2rem;">
                      <%= sub.user.email.first(2).upcase %>
                    </div>
                    <span class="fw-medium"><%= sub.user.email.split('@').first.capitalize %></span>
                  </div>
                </td>
                <td class="px-3 py-3 small"><%= sub.experiment.title %></td>
                <td class="px-3 py-3">
                  <span class="badge <%= status_badge_class(sub.status) %>"><%= sub.status.humanize %></span>
                </td>
                <td class="px-3 py-3 small text-body-secondary"><%= sub.created_at.strftime("%b %d, %H:%M") %></td>
                <td class="px-3 py-3">
                  <%= link_to submission_path(sub), class: "btn btn-link btn-sm text-secondary p-0" do %>
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if @recent_submissions.empty? %>
              <tr>
                <td colspan="5" class="px-3 py-4 text-center text-body-secondary">No submissions found.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-4">
    <div class="card border shadow-sm mb-4">
      <div class="card-body">
        <h3 class="h6 fw-bold mb-3">Weekly Activity</h3>
        <div class="d-flex align-items-end justify-content-between gap-1" style="height: 8rem;">
          <div class="flex-grow-1 bg-primary bg-opacity-25 rounded-top" style="height: 40%"></div>
          <div class="flex-grow-1 bg-primary bg-opacity-25 rounded-top" style="height: 65%"></div>
          <div class="flex-grow-1 bg-primary bg-opacity-25 rounded-top" style="height: 45%"></div>
          <div class="flex-grow-1 bg-primary rounded-top" style="height: 85%"></div>
          <div class="flex-grow-1 bg-primary bg-opacity-25 rounded-top" style="height: 30%"></div>
          <div class="flex-grow-1 bg-primary bg-opacity-25 rounded-top" style="height: 50%"></div>
          <div class="flex-grow-1 bg-primary bg-opacity-25 rounded-top" style="height: 60%"></div>
        </div>
        <div class="d-flex justify-content-between mt-2 small text-body-secondary">
          <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
      </div>
    </div>
    <div class="card bg-primary text-white overflow-hidden">
      <div class="card-body position-relative">
        <h3 class="h6 fw-bold mb-2">Lab Controls</h3>
        <p class="small opacity-75 mb-3">Quickly manage running sessions.</p>
        <div class="row g-2">
          <div class="col-6"><button type="button" class="btn btn-light btn-sm w-100 opacity-75">Broadcast Msg</button></div>
          <div class="col-6"><button type="button" class="btn btn-light btn-sm w-100 opacity-75">Stop All</button></div>
        </div>
      </div>
    </div>
  </div>
</div>
