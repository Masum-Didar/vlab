<header class="flex justify-between items-center mb-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">
      <%= params[:role].to_s.capitalize.presence || "Users" %>
    </h1>
    <p class="text-gray-500 mt-1">
      <%= params[:role] == "student" ? "List of enrolled students." : "List of faculties." %>
    </p>
  </div>
</header>

<div class="bg-white rounded-xl shadow-sm border border-gray-200">
  <div class="p-6 flex justify-between items-center border-b border-gray-100">
    <input type="text" placeholder="Search students..." class="px-3 py-2 border rounded-lg text-sm">
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
      <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
        <th class="px-6 py-3">Full Name</th>
        <th class="px-6 py-3">Email</th>
        <th class="px-6 py-3">Joined</th>
        <th class="px-6 py-3 text-right">Actions</th>
      </tr>
      </thead>

      <tbody class="divide-y divide-gray-100">
      <% @users.each do |stu| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-3 font-medium text-gray-900"><%= stu.full_name %></td>
          <td class="px-6 py-3 text-gray-600"><%= stu.email %></td>
          <td class="px-6 py-3 text-gray-500"><%= stu.created_at.strftime("%b %d, %Y") %></td>
          <td class="px-6 py-3 text-right">
            <%= link_to "View", user_path(stu), class: "text-indigo-600 hover:text-indigo-800 text-sm" %>
          </td>
        </tr>
      <% end %>

      <% if @users.empty? %>
        <tr>
          <td colspan="4" class="px-6 py-8 text-center text-gray-400">No students found.</td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
