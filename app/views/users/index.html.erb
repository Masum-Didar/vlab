<header class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h2 fw-bold text-dark"><%= params[:role].to_s.capitalize.presence || "Users" %></h1>
    <p class="text-body-secondary mb-0 mt-1 small"><%= params[:role] == "student" ? "List of enrolled students." : "List of faculties." %></p>
  </div>
</header>

<div class="card border shadow-sm">
  <div class="card-header bg-white py-3">
    <input type="text" placeholder="Search..." class="form-control form-control-sm" style="max-width: 16rem;">
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light text-uppercase small">
        <tr>
          <th class="px-3 py-3">Full Name</th>
          <th class="px-3 py-3">Email</th>
          <th class="px-3 py-3">Joined</th>
          <th class="px-3 py-3 text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |stu| %>
          <tr>
            <td class="px-3 py-3 fw-medium"><%= stu.full_name %></td>
            <td class="px-3 py-3 text-body-secondary"><%= stu.email %></td>
            <td class="px-3 py-3 text-body-secondary small"><%= stu.created_at.strftime("%b %d, %Y") %></td>
            <td class="px-3 py-3 text-end">
              <%= link_to "View", user_path(stu), class: "btn btn-link btn-sm text-primary p-0" %>
            </td>
          </tr>
        <% end %>
        <% if @users.empty? %>
          <tr>
            <td colspan="4" class="px-3 py-4 text-center text-body-secondary">No students found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
