<div class="container" style="max-width: 28rem;">
  <div class="card shadow border-0 overflow-hidden my-4">
    <div class="card-body text-center pt-4 pb-3">
      <h2 class="h4 fw-bold text-dark">Create Account</h2>
      <p class="small text-body-secondary mt-2 mb-0">Join VLab to start experimenting</p>
    </div>
    <div class="card-body pt-0 pb-4">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "d-flex flex-column gap-3" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div class="row g-3">
          <div class="col-6">
            <%= f.label :first_name, class: "form-label small fw-medium" %>
            <%= f.text_field :first_name, autofocus: true, class: "form-control" %>
          </div>
          <div class="col-6">
            <%= f.label :last_name, class: "form-label small fw-medium" %>
            <%= f.text_field :last_name, class: "form-control" %>
          </div>
        </div>
        <div>
          <%= f.label :email, class: "form-label small fw-medium" %>
          <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
        </div>
        <div>
          <%= f.label :role, "I am a...", class: "form-label small fw-medium" %>
          <%= f.select :role, User.roles.keys.map { |role| [role.capitalize, role] }, {}, class: "form-select" %>
        </div>
        <div>
          <%= f.label :password, class: "form-label small fw-medium" %>
          <% if @minimum_password_length %>
            <span class="small text-body-secondary float-end">(<%= @minimum_password_length %> chars min)</span>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "form-label small fw-medium" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
        </div>
        <%= f.submit "Create Account", class: "btn btn-primary w-100 fw-semibold" %>
      <% end %>
    </div>
    <div class="card-footer bg-light text-center py-3">
      <div class="small text-primary">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
