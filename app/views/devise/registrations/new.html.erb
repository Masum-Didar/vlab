<%#= render "devise/shared/links" %>
<div class="w-full max-w-md bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 my-8">

  <div class="px-8 pt-8 pb-4 text-center">
    <h2 class="text-2xl font-bold text-gray-900">Create Account</h2>
    <p class="text-sm text-gray-500 mt-2">Join VLab to start experimenting</p>
  </div>

  <div class="px-8 pb-8">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- First Name & Last Name (Grid) -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :first_name, autofocus: true, class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
        </div>
        <div>
          <%= f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :last_name, class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
        </div>
      </div>

      <!-- Email -->
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email", class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
      </div>

      <!-- Role Selection -->
      <div>
        <%= f.label :role, "I am a...", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :role, User.roles.keys.map { |role| [role.capitalize, role] }, {}, class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white" %>
      </div>

      <!-- Password -->
      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <% if @minimum_password_length %>
          <span class="text-xs text-gray-400 float-right mt-1">(<%= @minimum_password_length %> chars min)</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
      </div>

      <!-- Confirm Password -->
      <div>
        <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
      </div>

      <%= f.submit "Create Account", class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mt-6 cursor-pointer" %>
    <% end %>
  </div>

<!--  <div class="bg-gray-50 px-8 py-4 border-t border-gray-100 text-center">-->
<!--    <p class="text-xs text-gray-600">-->
<!--      Already have an account?-->
      <%#= link_to "Sign in instead", new_session_path(resource_name), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
<!--    </p>-->
<!--  </div>-->
  <div class="bg-gray-50 px-8 py-4 border-t border-gray-100 text-center">
    <div class="text-sm text-indigo-600">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
