<header class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h2 fw-bold text-dark">Submissions</h1>
    <p class="text-body-secondary mb-0 mt-1 small">Student experiment submissions.</p>
  </div>
</header>

<div class="card border shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light text-uppercase small">
        <tr>
          <th class="px-3 py-3">Student</th>
          <th class="px-3 py-3">Experiment</th>
          <th class="px-3 py-3">Status</th>
          <th class="px-3 py-3">Submitted</th>
          <th class="px-3 py-3 text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @submissions.each do |s| %>
          <tr>
            <td class="px-3 py-3 fw-medium"><%= s.user.email.split('@').first.capitalize %></td>
            <td class="px-3 py-3 text-body-secondary"><%= s.experiment.title %></td>
            <td class="px-3 py-3">
              <span class="badge <%= status_badge_class(s.status) %>"><%= s.status.humanize %></span>
            </td>
            <td class="px-3 py-3 text-body-secondary small"><%= s.created_at.strftime("%b %d, %H:%M") %></td>
            <td class="px-3 py-3 text-end">
              <%= link_to "Review", submission_path(s), class: "btn btn-link btn-sm text-primary p-0" %>
            </td>
          </tr>
        <% end %>
        <% if @submissions.empty? %>
          <tr>
            <td colspan="5" class="px-3 py-4 text-center text-body-secondary">No submissions yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
