<header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div>
    <h1 class="h2 fw-bold text-dark">Lab Sessions</h1>
    <p class="text-body-secondary mb-0 mt-1 small">Monitor and manage ongoing lab sessions.</p>
  </div>
  <%= link_to new_lab_session_path, class: "btn btn-primary d-inline-flex align-items-center gap-2" do %>
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    New Session
  <% end %>
</header>

<div class="card border shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light text-uppercase small">
        <tr>
          <th class="px-3 py-3">Experiment</th>
          <th class="px-3 py-3">Instructor</th>
          <th class="px-3 py-3">Status</th>
          <th class="px-3 py-3">Started</th>
          <th class="px-3 py-3 text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @lab_sessions.each do |s| %>
          <tr>
            <td class="px-3 py-3 fw-medium"><%= s.experiment.title %></td>
            <td class="px-3 py-3 text-body-secondary"><%= s.user.name %></td>
            <td class="px-3 py-3">
              <span class="badge <%= status_badge_class(s.status) %>"><%= s.status.humanize %></span>
            </td>
            <td class="px-3 py-3 text-body-secondary small"><%= s.created_at.strftime("%b %d, %H:%M") %></td>
            <td class="px-3 py-3 text-end">
              <%= link_to "Manage", lab_session_path(s), class: "btn btn-link btn-sm text-primary p-0" %>
            </td>
          </tr>
        <% end %>
        <% if @lab_sessions.empty? %>
          <tr>
            <td colspan="5" class="px-3 py-4 text-center text-body-secondary">No sessions running.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
