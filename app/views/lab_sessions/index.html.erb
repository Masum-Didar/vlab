<header class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">Lab Sessions</h1>
    <p class="text-gray-500 mt-1">Monitor and manage ongoing lab sessions.</p>
  </div>

  <%= link_to new_lab_session_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-lg" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    New Session
  <% end %>
</header>

<div class="bg-white rounded-xl shadow-sm border border-gray-200">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
      <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
        <th class="px-6 py-3">Experiment</th>
        <th class="px-6 py-3">Instructor</th>
        <th class="px-6 py-3">Status</th>
        <th class="px-6 py-3">Started</th>
        <th class="px-6 py-3 text-right">Actions</th>
      </tr>
      </thead>

      <tbody class="divide-y divide-gray-100">
      <% @lab_sessions.each do |s| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-3 font-medium text-gray-900"><%= s.experiment.title %></td>
          <td class="px-6 py-3 text-gray-600"><%= s.user.name %></td>

          <td class="px-6 py-3">
            <span class="px-2 py-1 text-xs rounded-full font-medium border <%= status_badge_class(s.status) %>">
              <%= s.status.humanize %>
            </span>
          </td>

          <td class="px-6 py-3 text-gray-500"><%= s.created_at.strftime("%b %d, %H:%M") %></td>

          <td class="px-6 py-3 text-right">
            <%= link_to "Manage", lab_session_path(s), class: "text-indigo-600 hover:text-indigo-800 text-sm" %>
          </td>
        </tr>
      <% end %>

      <% if @lab_sessions.empty? %>
        <tr>
          <td colspan="5" class="px-6 py-8 text-center text-gray-400">No sessions running.</td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
