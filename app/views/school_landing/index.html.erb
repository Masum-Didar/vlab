<div class="w-full max-w-4xl mx-auto">
  <!-- School Header -->
  <div class="text-center mb-12">
    <!-- School Logo Placeholder -->
    <div class="flex justify-center mb-6">
      <div class="w-24 h-24 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center shadow-lg">
        <span class="text-white text-3xl font-bold"><%= @school.name.first.upcase %></span>
      </div>
    </div>
    
    <h1 class="text-4xl font-bold text-gray-900 mb-2"><%= @school.name %></h1>
    <p class="text-xl text-gray-600 mb-4">Virtual Laboratory Platform</p>
    
    <!-- Tenant Confirmation Badge -->
    <div class="inline-flex items-center px-4 py-2 bg-green-100 border border-green-200 rounded-full">
      <svg class="w-5 h-5 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
      </svg>
      <span class="text-sm font-medium text-green-800">Connected to: <%= @school.subdomain %>.<%= Rails.env.development? ? "lvh.me" : request.domain %></span>
    </div>
  </div>

  <!-- Action Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <!-- Login Card -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
      <div class="px-8 pt-8 pb-6">
        <div class="flex items-center mb-4">
          <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>
          </div>
          <h2 class="text-xl font-semibold text-gray-900">Sign In</h2>
        </div>
        <p class="text-gray-600 text-sm mb-6">Access your VLab account to start experimenting</p>
        <%= link_to new_user_session_path, class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" do %>
          Sign In to Your Account
        <% end %>
      </div>
    </div>

    <!-- Dashboard Card (if logged in) -->
    <% if user_signed_in? %>
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
        <div class="px-8 pt-8 pb-6">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-gray-900">Dashboard</h2>
          </div>
          <p class="text-gray-600 text-sm mb-6">Go to your dashboard to manage experiments and view results</p>
          <%= link_to dashboard_path, class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors" do %>
            Go to Dashboard
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Register Card (if not logged in) -->
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
        <div class="px-8 pt-8 pb-6">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-gray-900">New User?</h2>
          </div>
          <p class="text-gray-600 text-sm mb-6">Create an account to access <%= @school.name %>'s virtual laboratory</p>
          <%= link_to new_user_registration_path, class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-colors" do %>
            Create Account
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- School Information Section -->
  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 mb-8">
    <div class="px-8 pt-8 pb-6">
      <h2 class="text-2xl font-semibold text-gray-900 mb-6">About <%= @school.name %></h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- School Details -->
        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-3">School Information</h3>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-700">School Name</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @school.name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-700">Subdomain</dt>
              <dd class="mt-1 text-sm text-gray-900 font-mono"><%= @school.subdomain %>.<%= Rails.env.development? ? "lvh.me" : request.domain %></dd>
            </div>
            <% if @school.domain.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-700">Domain</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @school.domain %></dd>
              </div>
            <% end %>
          </dl>
        </div>

        <!-- Platform Features -->
        <div>
          <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-3">Platform Features</h3>
          <ul class="space-y-2">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-sm text-gray-700">Secure multi-tenant architecture</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-sm text-gray-700">Virtual laboratory experiments</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-sm text-gray-700">Real-time experiment tracking</span>
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-sm text-gray-700">Comprehensive result analysis</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-2xl p-6 border border-indigo-100">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Links</h3>
    <div class="flex flex-wrap gap-3">
      <%= link_to "View Experiments", experiments_path, class: "px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" %>
      <%= link_to "Help & Support", "#", class: "px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" %>
      <% if user_signed_in? && (current_user.administrator? || current_user.faculty?) %>
        <%= link_to "Admin Dashboard", admin_dashboard_path, class: "px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" %>
      <% end %>
    </div>
  </div>
</div>
