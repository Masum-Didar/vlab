<div class="container" style="max-width: 56rem;">
  <div class="text-center mb-5">
    <div class="d-flex justify-content-center mb-3">
      <div class="rounded-3 bg-primary bg-opacity-75 text-white d-flex align-items-center justify-content-center shadow" style="width: 6rem; height: 6rem;">
        <span class="display-6 fw-bold"><%= @school.name.first.upcase %></span>
      </div>
    </div>
    <h1 class="display-5 fw-bold text-dark mb-2"><%= @school.name %></h1>
    <p class="lead text-body-secondary mb-3">Virtual Laboratory Platform</p>
    <span class="badge bg-success d-inline-flex align-items-center gap-1 px-3 py-2">
      <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
      Connected to: <%= @school.subdomain %>.<%= Rails.env.development? ? "lvh.me" : request.domain %>
    </span>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-12 col-md-6">
      <div class="card border shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-primary"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
            </div>
            <h2 class="h5 fw-semibold mb-0">Sign In</h2>
          </div>
          <p class="text-body-secondary small mb-3">Access your VLab account to start experimenting</p>
          <%= link_to "Sign In to Your Account", new_user_session_path, class: "btn btn-primary w-100" %>
        </div>
      </div>
    </div>
    <% if user_signed_in? %>
      <div class="col-12 col-md-6">
        <div class="card border shadow-sm h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-success bg-opacity-10 rounded p-2 me-3">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-success"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
              </div>
              <h2 class="h5 fw-semibold mb-0">Dashboard</h2>
            </div>
            <p class="text-body-secondary small mb-3">Go to your dashboard to manage experiments and view results</p>
            <%= link_to "Go to Dashboard", dashboard_path, class: "btn btn-success w-100" %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="col-12 col-md-6">
        <div class="card border shadow-sm h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-secondary bg-opacity-10 rounded p-2 me-3">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-secondary"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
              </div>
              <h2 class="h5 fw-semibold mb-0">New User?</h2>
            </div>
            <p class="text-body-secondary small mb-3">Create an account to access <%= @school.name %>'s virtual laboratory</p>
            <%= link_to "Create Account", new_user_registration_path, class: "btn btn-secondary w-100" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="card border shadow-sm mb-4">
    <div class="card-body p-4">
      <h2 class="h5 fw-semibold text-dark mb-4">About <%= @school.name %></h2>
      <div class="row g-4">
        <div class="col-12 col-md-6">
          <h3 class="small fw-medium text-uppercase text-body-secondary mb-3">School Information</h3>
          <dl class="mb-0">
            <dt class="small fw-medium text-body">School Name</dt>
            <dd class="small text-dark mb-2"><%= @school.name %></dd>
            <dt class="small fw-medium text-body">Subdomain</dt>
            <dd class="small text-dark mb-2 font-monospace"><%= @school.subdomain %>.<%= Rails.env.development? ? "lvh.me" : request.domain %></dd>
            <% if @school.domain.present? %>
              <dt class="small fw-medium text-body">Domain</dt>
              <dd class="small text-dark mb-0"><%= @school.domain %></dd>
            <% end %>
          </dl>
        </div>
        <div class="col-12 col-md-6">
          <h3 class="small fw-medium text-uppercase text-body-secondary mb-3">Platform Features</h3>
          <ul class="list-unstyled small text-body mb-0">
            <li class="d-flex align-items-start gap-2 mb-2"><span class="text-success">✓</span> Secure multi-tenant architecture</li>
            <li class="d-flex align-items-start gap-2 mb-2"><span class="text-success">✓</span> Virtual laboratory experiments</li>
            <li class="d-flex align-items-start gap-2 mb-2"><span class="text-success">✓</span> Real-time experiment tracking</li>
            <li class="d-flex align-items-start gap-2 mb-0"><span class="text-success">✓</span> Comprehensive result analysis</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="card border shadow-sm bg-primary bg-opacity-10 p-4">
    <h3 class="h6 fw-semibold text-dark mb-3">Quick Links</h3>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "View Experiments", experiments_path, class: "btn btn-light btn-sm" %>
      <%= link_to "Help & Support", "#", class: "btn btn-light btn-sm" %>
      <% if user_signed_in? && (current_user.administrator? || current_user.faculty?) %>
        <%= link_to "Admin Dashboard", admin_dashboard_path, class: "btn btn-light btn-sm" %>
      <% end %>
    </div>
  </div>
</div>
