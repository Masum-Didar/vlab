<% if action.step_action_transfers.any? %>

  <ul class="mb-0 small">

    <% action.step_action_transfers.each do |t| %>

      <li>

        <%= t.source_container.name %>

        ➜

        <%= t.target_container.name %>

      </li>

    <% end %>

  </ul>

<% else %>

  <span class="text-muted small">
    No transfer defined
  </span>

<% end %>