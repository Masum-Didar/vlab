<%= form_with model: [:admin, @chemical], class: "d-flex flex-column gap-3" do |f| %>
  <div>
    <%= f.label :name, class: "form-label fw-medium" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div>
    <%= f.label :formula, class: "form-label fw-medium" %>
    <%= f.text_field :formula, class: "form-control" %>
  </div>

  <div>
    <%= f.label :description, class: "form-label fw-medium" %>
    <%= f.text_area :description, rows: 3, class: "form-control" %>
  </div>

  <div>
    <%= f.label :state, class: "form-label fw-medium" %>
    <%= f.select :state,
                 options_for_select(
                   [["Solid", "solid"],
                    ["Liquid", "liquid"],
                    ["Gas", "gas"],
                    ["Aqueous", "aqueous"]],
                   @chemical.state
                 ),
                 { include_blank: "Select State" },
                 class: "form-select" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>