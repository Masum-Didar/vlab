<%= form_with model: step_action_transfer,
              url: admin_step_action_step_action_transfers_path(step_action),
              local: true do |f| %>

  <div class="mb-3">
    <%= f.label :source_container_id, "Source Container" %>
    <%= f.collection_select :source_container_id,
                            @containers,
                            :id,
                            ->(c) { "#{c.name} (#{c.container_type})" },
                            { prompt: "Select Source Container" },
                            { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :target_container_id, "Target Container" %>
    <%= f.collection_select :target_container_id,
                            @containers,
                            :id,
                            ->(c) { "#{c.name} (#{c.container_type})" },
                            { prompt: "Select Target Container" },
                            { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :chemical_id, "Chemical" %>
    <%= f.collection_select :chemical_id,
                            @chemicals,
                            :id,
                            :name,
                            { prompt: "Select Chemical" },
                            { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :quantity, "Quantity / Volume" %>
    <%= f.number_field :quantity,
                       class: "form-control",
                       step: 0.1,
                       placeholder: "e.g. 10 ml" %>
  </div>

  <div class="modal-footer">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
    <%= f.submit "Save Transfer", class: "btn btn-primary" %>
  </div>

<% end %>
