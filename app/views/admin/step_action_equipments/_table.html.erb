<% if @step_action.step_action_equipments.any? %>
  <table class="table table-sm table-bordered">
    <thead class="table-light">
    <tr>
      <th>#</th>
      <th>Equipment</th>
      <th>Instruction</th>
    </tr>
    </thead>
    <tbody>
    <% @step_action.step_action_equipments.each_with_index do |eq, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= eq.equipment.name if eq.equipment.present? %></td>
        <td><%= eq.instruction.presence || "-" %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted small mb-0">No equipments added yet.</p>
<% end %>
