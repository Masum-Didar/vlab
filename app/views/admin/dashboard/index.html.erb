<% content_for :title, "Dashboard" %>

<div class="d-flex flex-column gap-4">
  <div class="row g-3">
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary small mb-0">Total Experiments</p>
          <h3 class="h4 fw-semibold mt-2 mb-0"><%= @experiments_count %></h3>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary small mb-0">Total Users</p>
          <h3 class="h4 fw-semibold mt-2 mb-0"><%= @users_count %></h3>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary small mb-0">Active Sessions</p>
          <h3 class="h4 fw-semibold mt-2 mb-0"><%= @active_count %></h3>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border shadow-sm">
        <div class="card-body">
          <p class="text-body-secondary small mb-0">Pending Experiments</p>
          <h3 class="h4 fw-semibold mt-2 mb-0"><%= @pending_count %></h3>
        </div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card border shadow-sm <%= 'border-warning' if @pending_faculty_count > 0 %>">
        <div class="card-body">
          <p class="text-body-secondary small mb-0">Pending Faculty</p>
          <h3 class="h4 fw-semibold mt-2 mb-0">
            <%= link_to admin_faculty_index_path, class: "text-decoration-none #{@pending_faculty_count > 0 ? 'text-warning' : 'text-body'}" do %>
              <%= @pending_faculty_count %>
            <% end %>
          </h3>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-lg-8">
      <div class="card border shadow-sm">
        <div class="card-body">
          <h4 class="h6 fw-semibold mb-3">Experiment Activity</h4>
          <div class="d-flex justify-content-center align-items-center bg-light rounded text-body-secondary" style="height: 12rem;">
            📊 Chart placeholder (later we add real chart.js)
          </div>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-4">
      <div class="card border shadow-sm">
        <div class="card-body">
          <h4 class="h6 fw-semibold mb-3">Quick Stats</h4>
          <div class="d-flex justify-content-between small mb-2"><span class="text-body-secondary">Completed Experiments</span><span class="fw-medium"><%= @completed_count %></span></div>
          <div class="d-flex justify-content-between small mb-2"><span class="text-body-secondary">Failed Experiments</span><span class="fw-medium"><%= @failed_count %></span></div>
          <div class="d-flex justify-content-between small mb-0"><span class="text-body-secondary">Average Duration</span><span class="fw-medium"><%= @avg_duration %> min</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card border shadow-sm">
    <div class="card-body">
      <h4 class="h6 fw-semibold mb-3">Recent Experiments</h4>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr class="border-bottom">
              <th class="py-2">Title</th>
              <th class="py-2">Status</th>
              <th class="py-2">Created</th>
              <th class="py-2 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_experiments.each do |exp| %>
              <tr class="border-bottom">
                <td class="py-3"><%= exp.title %></td>
                <td class="py-3">
                  <span class="badge <%= exp.status == 'completed' ? 'bg-success' : 'bg-warning text-dark' %>"><%= exp.status.capitalize %></span>
                </td>
                <td class="py-3"><%= exp.created_at.strftime("%b %d, %Y") %></td>
                <td class="py-3 text-end">
                  <%= link_to "View", admin_experiment_path(exp), class: "btn btn-link btn-sm text-primary p-0" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
