<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h2 fw-bold text-dark mb-0">Experiments</h1>
  <%= link_to "+ Add Experiment", new_admin_experiment_path, class: "btn btn-primary" %>
</div>

<div class="card border shadow-sm">
  <div class="card-body p-0">
    <% if @experiments.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="py-3">Title</th>
              <th class="py-3">Status</th>
              <th class="py-3">Created At</th>
              <th class="py-3 text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @experiments.each do |exp| %>
              <tr>
                <td class="py-3 fw-medium"><%= exp.title %></td>
                <td class="py-3">
                  <span class="badge <%= { 'started' => 'bg-primary', 'completed' => 'bg-success', 'failed' => 'bg-danger' }[exp.status] || 'bg-secondary' %>"><%= exp.status.capitalize %></span>
                </td>
                <td class="py-3"><%= exp.created_at.strftime("%d %b %Y") %></td>
                <td class="py-3 text-end">
                  <%= link_to "View", admin_experiment_path(exp), class: "btn btn-link btn-sm text-primary p-0 me-2" %>
                  <%= link_to "Edit", edit_admin_experiment_path(exp), class: "btn btn-link btn-sm p-0 me-2" %>
                  <%= link_to "Delete", admin_experiment_path(exp), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-link btn-sm text-danger p-0" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-body-secondary text-center py-5 mb-0">No experiments found.</p>
    <% end %>
  </div>
</div>
