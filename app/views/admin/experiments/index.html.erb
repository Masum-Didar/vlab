<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-800">Experiments</h1>

  <%= link_to "+ Add Experiment", new_admin_experiment_path,
              class: "bg-indigo-600 text-white px-4 py-2 rounded-lg shadow hover:bg-indigo-700 transition" %>
</div>


<div class="bg-white shadow-md rounded-xl p-6 border border-gray-100">

  <% if @experiments.any? %>
    <table class="w-full border-collapse text-sm">
      <thead>
      <tr class="border-b text-left text-gray-600">
        <th class="py-3">Title</th>
        <th class="py-3">Status</th>
        <th class="py-3">Created At</th>
        <th class="py-3 text-right">Actions</th>
      </tr>
      </thead>

      <tbody>
      <% @experiments.each do |exp| %>
        <tr class="border-b hover:bg-gray-50 transition">
          <td class="py-3 font-medium"><%= exp.title %></td>
          <td class="py-3">
              <span class="px-2 py-1 rounded text-xs
                <%= {
                                                 'started' => 'bg-blue-100 text-blue-700',
                                                 'completed' => 'bg-green-100 text-green-700',
                                                 'failed' => 'bg-red-100 text-red-700'
                                               }[exp.status] %>">
                <%= exp.status.capitalize %>
              </span>
          </td>

          <td class="py-3"><%= exp.created_at.strftime("%d %b %Y") %></td>

          <td class="py-3 text-right space-x-2">
            <%= link_to "View", admin_experiment_path(exp),
                        class: "text-indigo-600 hover:underline" %>
            <%= link_to "Edit", edit_admin_experiment_path(exp),
                        class: "text-blue-600 hover:underline" %>
            <%= link_to "Delete", admin_experiment_path(exp),
                        data: { confirm: "Are you sure?" }, method: :delete,
                        class: "text-red-600 hover:underline" %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>

  <% else %>
    <p class="text-gray-500 text-center py-8">No experiments found.</p>
  <% end %>
</div>
