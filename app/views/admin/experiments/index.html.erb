<% content_for :title, "Experiments" %>

<header class="admin-page-head">
  <div>
    <p class="admin-page-head__eyebrow">Faculty workspace</p>
    <h1>Experiments</h1>
    <p>Create, organize, publish, and review virtual lab experiments for students.</p>
  </div>
  <%= link_to "New experiment", new_admin_experiment_path, class: "btn btn-primary" %>
</header>

<section class="admin-summary-grid">
  <div class="admin-summary">
    <span>Total</span>
    <strong><%= @experiments.size %></strong>
  </div>
  <div class="admin-summary">
    <span>Published</span>
    <strong><%= @experiments.count(&:published?) %></strong>
  </div>
  <div class="admin-summary">
    <span>Drafts</span>
    <strong><%= @experiments.count { |experiment| !experiment.published? } %></strong>
  </div>
  <div class="admin-summary">
    <span>Interactive</span>
    <strong><%= @experiments.count { |experiment| experiment.experiment_phases.any? { |phase| phase.phase_steps.any? { |step| step.step_actions.any? } } } %></strong>
  </div>
</section>

<section class="admin-table-card">
  <% if @experiments.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Experiment</th>
            <th>Interactions</th>
            <th>Flow</th>
            <th>Readiness</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @experiments.each do |experiment| %>
            <% steps_count = experiment.experiment_phases.sum { |phase| phase.phase_steps.size } %>
            <tr>
              <td>
                <strong><%= experiment.title %></strong>
                <div class="text-body-secondary small"><%= truncate(experiment.description, length: 86) %></div>
              </td>
              <td>
                <div class="d-flex gap-1 flex-wrap">
                  <% interaction_types = experiment.experiment_phases.flat_map { |phase| phase.phase_steps.flat_map { |step| step.step_actions.map(&:action_type) } }.uniq %>
                  <% if interaction_types.any? %>
                    <% interaction_types.first(3).each do |type| %>
                      <span class="badge text-bg-info"><%= type.humanize %></span>
                    <% end %>
                    <% if interaction_types.size > 3 %>
                      <span class="badge text-bg-light text-dark border">+<%= interaction_types.size - 3 %></span>
                    <% end %>
                  <% else %>
                    <span class="badge text-bg-light text-secondary border">Not configured</span>
                  <% end %>
                </div>
              </td>
              <td>
                <span class="fw-semibold"><%= experiment.experiment_phases.size %></span>
                <span class="text-body-secondary small">phases</span>
                <span class="mx-1 text-body-secondary">·</span>
                <span class="fw-semibold"><%= steps_count %></span>
                <span class="text-body-secondary small">steps</span>
              </td>
              <td style="min-width: 9rem;">
                <div class="progress admin-progress" role="progressbar" aria-valuenow="<%= experiment_ready_percentage(experiment) %>" aria-valuemin="0" aria-valuemax="100">
                  <div class="progress-bar" style="width: <%= experiment_ready_percentage(experiment) %>%"></div>
                </div>
                <span class="small text-body-secondary"><%= experiment_ready_percentage(experiment) %>% ready</span>
              </td>
              <td>
                <span class="badge <%= experiment_status_badge_class(experiment) %>"><%= experiment.published? ? "Published" : experiment.status.titleize %></span>
              </td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <%= link_to "Manage", admin_experiment_path(experiment), class: "btn btn-outline-primary" %>
                  <%= link_to "Edit", edit_admin_experiment_path(experiment), class: "btn btn-outline-secondary" %>
                  <%= link_to "Student view", lab_experiment_path(experiment), class: "btn btn-outline-secondary", target: "_blank", rel: "noopener" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty">
      <h2>No experiments yet</h2>
      <p>Start by uploading materials, adding settings, and defining the student flow.</p>
      <%= link_to "Create first experiment", new_admin_experiment_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
