<div class="max-w-3xl mx-auto bg-white border rounded-2xl p-8 shadow-md space-y-6">

  <h2 class="text-2xl font-bold">Create New Experiment</h2>
  <p class="text-gray-500 text-sm">Add details for lab experiment flow.</p>

  <%= form_with model: [:admin, @experiment], class: "space-y-6" do |f| %>

    <div>
      <%= f.label :title, class: "block text-sm font-medium" %>
      <%= f.text_field :title, class:"w-full rounded-lg border px-3 py-2 mt-1" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium" %>
      <%= f.text_area :description, rows: 4, class:"w-full rounded-lg border px-3 py-2 mt-1" %>
    </div>

    <div>
      <%= f.label :difficulty, class: "block text-sm font-medium" %>
      <%= f.select :difficulty, %w[Easy Medium Hard], {}, class:"w-full border rounded-lg px-3 py-2 mt-1" %>
    </div>

    <div>
      <%= f.label :status, class: "block text-sm font-medium" %>
      <%= f.select :status, Experiment.statuses.keys.map{|s| [s.capitalize,s]}, {}, class:"w-full border rounded-lg px-3 py-2 mt-1" %>
    </div>

    <div>
      <%= f.label :duration, "Average Duration (min)", class: "block text-sm font-medium" %>
      <%= f.number_field :duration, class:"w-full border rounded-lg px-3 py-2 mt-1" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :published %>
      <%= f.label :published, "Publish Now" %>
    </div>

    <%= f.submit "Create Experiment",
                 class:"w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg cursor-pointer" %>

  <% end %>
</div>
