<div class="container" style="max-width: 48rem;">
  <div class="card border shadow-sm">
    <div class="card-body p-4">
      <h2 class="h4 fw-bold mb-2">Create New Experiment</h2>
      <p class="text-body-secondary small mb-4">Add details for lab experiment flow.</p>

      <%= form_with model: [:admin, @experiment], html: { class: "d-flex flex-column gap-4" } do |f| %>
        <div>
          <%= f.label :title, class: "form-label small fw-medium" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <div>
          <%= f.label :description, class: "form-label small fw-medium" %>
          <%= f.text_area :description, rows: 4, class: "form-control" %>
        </div>
        <div>
          <%= f.label :difficulty, class: "form-label small fw-medium" %>
          <%= f.select :difficulty, %w[Easy Medium Hard], {}, class: "form-select" %>
        </div>
        <div>
          <%= f.label :status, class: "form-label small fw-medium" %>
          <%= f.select :status, Experiment.statuses.keys.map { |s| [s.capitalize, s] }, {}, class: "form-select" %>
        </div>
        <div>
          <%= f.label :duration, "Average Duration (min)", class: "form-label small fw-medium" %>
          <%= f.number_field :duration, class: "form-control" %>
        </div>
        <div class="form-check">
          <%= f.check_box :published, class: "form-check-input" %>
          <%= f.label :published, "Publish Now", class: "form-check-label" %>
        </div>
        <%= f.submit "Create Experiment", class: "btn btn-primary w-100 fw-semibold" %>
      <% end %>
    </div>
  </div>
</div>
