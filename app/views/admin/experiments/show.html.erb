<% content_for :title, @experiment.title %>

<header class="admin-page-head">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2 small">
        <li class="breadcrumb-item"><%= link_to "Experiments", admin_experiments_path %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= truncate(@experiment.title, length: 42) %></li>
      </ol>
    </nav>
    <h1><%= @experiment.title %></h1>
    <p><%= @experiment.description.presence || "No description added yet." %></p>
    <div class="d-flex gap-2 flex-wrap">
      <span class="badge <%= experiment_status_badge_class(@experiment) %>"><%= @experiment.published? ? "Published for students" : "Draft" %></span>
      <span class="badge text-bg-light border text-dark"><%= @experiment.duration.to_i %> min</span>
      <span class="badge text-bg-light border text-dark">Difficulty <%= @experiment.difficulty.presence || "unset" %></span>
    </div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <%= link_to "Edit setup", edit_admin_experiment_path(@experiment), class: "btn btn-primary" %>
    <%= link_to "Preview student lab", lab_experiment_path(@experiment), class: "btn btn-outline-secondary", target: "_blank", rel: "noopener" %>
    <%= link_to "Delete", admin_experiment_path(@experiment), data: { turbo_method: :delete, turbo_confirm: "Delete this experiment?" }, class: "btn btn-outline-danger" %>
  </div>
</header>

<div class="admin-detail-grid">
  <main class="admin-detail-main">
    <section class="admin-panel">
      <div class="admin-panel__heading">
        <div>
          <h2>Setup Readiness</h2>
          <p>Use this checklist before publishing the lab for students.</p>
        </div>
        <span class="admin-chip"><%= experiment_ready_percentage(@experiment) %>% ready</span>
      </div>

      <div class="admin-readiness">
        <% experiment_readiness_items(@experiment).each do |label, ready| %>
          <div class="admin-readiness__item <%= "is-ready" if ready %>">
            <span><%= ready ? "OK" : "!" %></span>
            <strong><%= label %></strong>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel">
      <div class="admin-panel__heading">
        <div>
          <h2>Experiment Method</h2>
          <p>Full process shown as faculty guidance for this experiment.</p>
        </div>
        <%= link_to "Edit method", edit_admin_experiment_path(@experiment, anchor: "settings"), class: "btn btn-outline-primary btn-sm" %>
      </div>

      <div class="text-body-secondary">
        <%= simple_format(@experiment.method_description.presence || "No method added yet.") %>
      </div>
    </section>

    <section class="admin-panel">
      <div class="admin-panel__heading">
        <div>
          <h2>Student Flow</h2>
          <p>Phases and steps students will follow in the lab screen.</p>
        </div>
        <%= link_to "Edit flow", edit_admin_experiment_path(@experiment, anchor: "flow"), class: "btn btn-outline-primary btn-sm" %>
      </div>

      <div class="admin-flow-preview">
        <% @experiment.experiment_phases.each do |phase| %>
          <article class="admin-flow-preview__phase">
            <div class="admin-flow-preview__phase-head">
              <span><%= phase.position %></span>
              <div>
                <h3><%= phase.title %></h3>
                <p><%= phase.description %></p>
              </div>
            </div>

            <% if phase.phase_steps.any? %>
              <ol>
                <% phase.phase_steps.each do |step| %>
                  <li>
                    <strong>Step <%= step.step_number %></strong>
                    <span><%= step.instruction %></span>
                    <% if step.timer_duration.present? %>
                      <em><%= step.timer_duration %> sec</em>
                    <% end %>
                    <% if step.step_actions.any? %>
                      <div class="admin-action-preview">
                        <% step.step_actions.each do |action| %>
                          <span class="badge text-bg-info"><%= action.action_type.humanize %></span>
                          <small><%= step_action_summary(action) %></small>
                        <% end %>
                      </div>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            <% else %>
              <p class="text-body-secondary small mb-0">No steps added.</p>
            <% end %>
          </article>
        <% end %>
      </div>
    </section>
  </main>

  <aside class="admin-detail-side">
    <section class="admin-panel">
      <div class="admin-panel__heading">
        <div>
          <h2>Interactive Steps</h2>
          <p>Configured action types in this experiment.</p>
        </div>
      </div>
      <dl class="admin-resource-list">
        <dt>Match equipment</dt>
        <dd><%= @experiment.experiment_phases.sum { |phase| phase.phase_steps.sum { |step| step.step_actions.count(&:label_match?) } } %></dd>
        <dt>Connect equipment</dt>
        <dd><%= @experiment.experiment_phases.sum { |phase| phase.phase_steps.sum { |step| step.step_actions.count(&:equipment_connect?) } } %></dd>
        <dt>Transfer chemical</dt>
        <dd><%= @experiment.experiment_phases.sum { |phase| phase.phase_steps.sum { |step| step.step_actions.count(&:transfer?) } } %></dd>
        <dt>Quiz / input</dt>
        <dd><%= @experiment.experiment_phases.sum { |phase| phase.phase_steps.sum { |step| step.step_actions.count(&:quiz_input?) } } %></dd>
        <dt>Last updated</dt>
        <dd><%= @experiment.updated_at.strftime("%d %b %Y") %></dd>
      </dl>
    </section>
  </aside>
</div>
