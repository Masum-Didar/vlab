<script>
  document.addEventListener("turbo:load", setupAdminFlowBuilder);
  document.addEventListener("DOMContentLoaded", setupAdminFlowBuilder);

  function setupAdminFlowBuilder() {
    const builder = document.querySelector("[data-admin-flow-builder]");
    if (!builder || builder.dataset.ready === "true") return;
    builder.dataset.ready = "true";

    const phasesWrapper = builder.querySelector("[data-phases-wrapper]");
    const phaseTemplate = document.querySelector("[data-phase-template]").innerHTML;
    const stepTemplate = document.querySelector("[data-step-template]").innerHTML;

    builder.querySelector("[data-add-phase]").addEventListener("click", () => {
      const phaseIndex = Date.now();
      phasesWrapper.insertAdjacentHTML("beforeend", phaseTemplate.replaceAll("PHASE_INDEX", phaseIndex));
    });

    phasesWrapper.addEventListener("click", (event) => {
      const phaseCard = event.target.closest("[data-phase-card]");

      if (event.target.matches("[data-remove-phase]") && phaseCard) {
        markDestroyedOrRemove(phaseCard);
      }

      if (event.target.matches("[data-add-step]") && phaseCard) {
        const stepsWrapper = phaseCard.querySelector("[data-steps-wrapper]");
        const phaseIndex = extractPhaseIndex(phaseCard) || Date.now();
        const stepIndex = Date.now();
        stepsWrapper.insertAdjacentHTML("beforeend", stepTemplate.replaceAll("PHASE_INDEX", phaseIndex).replaceAll("STEP_INDEX", stepIndex));
      }

      if (event.target.matches("[data-remove-step]")) {
        markDestroyedOrRemove(event.target.closest("[data-step-card]"));
      }
    });

    phasesWrapper.addEventListener("change", (event) => {
      if (event.target.matches("[data-action-type-select]")) {
        updateActionPanels(event.target.closest("[data-action-config-card]"));
      }
    });

    builder.querySelectorAll("[data-action-config-card]").forEach(updateActionPanels);
  }

  function markDestroyedOrRemove(element) {
    const destroyField = element.querySelector("[data-destroy-field]");
    const idField = element.querySelector("input[name$='[id]']");

    if (destroyField && idField && idField.value) {
      destroyField.value = "1";
      element.classList.add("d-none");
    } else {
      element.remove();
    }
  }

  function extractPhaseIndex(phaseCard) {
    const field = phaseCard.querySelector("input[name*='[experiment_phases_attributes]'], textarea[name*='[experiment_phases_attributes]']");
    const match = field && field.name.match(/experiment_phases_attributes\]\[([^\]]+)/);
    return match && match[1];
  }

  function updateActionPanels(card) {
    if (!card) return;
    const selectedType = card.querySelector("[data-action-type-select]").value;
    card.querySelectorAll("[data-config-panel]").forEach((panel) => {
      panel.classList.toggle("is-active", panel.dataset.configPanel === selectedType);
    });
  }
</script>
