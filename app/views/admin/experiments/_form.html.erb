<div class="container" style="max-width: 48rem;">
  <div class="card border shadow-sm">
    <div class="card-body p-4">
      <h2 class="h4 fw-bold mb-2"><%= @experiment.new_record? ? "Create New Experiment" : "Edit Experiment" %></h2>
      <p class="text-body-secondary small mb-4"><%= @experiment.new_record? ? "Add details for lab experiment flow." : "Update experiment details below." %></p>

      <%= form_with model: [:admin, @experiment], html: { class: "d-flex flex-column gap-4" } do |f| %>
        <div>
          <%= f.label :title, class: "form-label small fw-medium" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <div>
          <%= f.label :description, class: "form-label small fw-medium" %>
          <%= f.text_area :description, rows: 4, class: "form-control" %>
        </div>
        <div>
          <%= f.label :difficulty, class: "form-label small fw-medium" %>
          <%= f.select :difficulty, options_for_select([["Easy", 1], ["Medium", 2], ["Hard", 3]], @experiment.difficulty), { include_blank: "Select difficulty" }, class: "form-select" %>
        </div>
        <div>
          <%= f.label :status, class: "form-label small fw-medium" %>
          <%= f.select :status, Experiment.statuses.keys.map { |s| [s.capitalize, s] }, {}, class: "form-select" %>
        </div>
        <div>
          <%= f.label :duration, "Average Duration (min)", class: "form-label small fw-medium" %>
          <%= f.number_field :duration, class: "form-control" %>
        </div>
        <div class="form-check">
          <%= f.check_box :published, class: "form-check-input" %>
          <%= f.label :published, "Publish Now", class: "form-check-label" %>
        </div>



        <hr>
        <h5 class="fw-bold">Phases</h5>

        <div id="phases-wrapper">
          <%= f.fields_for :experiment_phases do |phase_form| %>

            <div class="card p-3 mb-3 phase-card">

              <div class="d-flex justify-content-between mb-2">
                <h6 class="fw-bold">Phase</h6>
                <button type="button" class="btn btn-sm btn-danger remove-phase">Remove</button>
              </div>

              <%= phase_form.text_field :title,
                                        class: "form-control mb-2",
                                        placeholder: "Phase Title" %>

              <%= phase_form.text_area :description,
                                       rows: 2,
                                       class: "form-control mb-3",
                                       placeholder: "Phase Description" %>


              <h6>Steps</h6>

              <div class="phase-steps-wrapper">

                <%= phase_form.fields_for :phase_steps do |step_form| %>

                  <div class="step-item border rounded p-2 mb-2 bg-light">

                    <%= step_form.number_field :step_number,
                                               class: "form-control mb-1",
                                               placeholder: "Step Number" %>

                    <%= step_form.text_area :instruction,
                                            rows: 2,
                                            class: "form-control mb-2",
                                            placeholder: "Step Instruction" %>

                    <button type="button"
                            class="btn btn-sm btn-outline-danger remove-step">
                      Remove Step
                    </button>

                  </div>

                <% end %>

              </div>

              <button type="button"
                      class="btn btn-sm btn-outline-primary add-step">
                + Add Step
              </button>

            </div>

          <% end %>
        </div>

        <button type="button" id="add-phase" class="btn btn-outline-secondary btn-sm">
          + Add Phase
        </button>

<!--        <div id="phases-wrapper">-->
          <%#= f.fields_for :experiment_phases do |phase_form| %>
<!--            <div class="card p-3 mb-3 phase-item">-->
<!--              <div class="mb-2">-->
                <%#= phase_form.label :title %>
                <%#= phase_form.text_field :title, class: "form-control" %>
<!--              </div>-->

<!--              <div class="mb-2">-->
                <%#= phase_form.label :description %>
                <%#= phase_form.text_area :description, rows: 2, class: "form-control" %>
<!--              </div>-->

<!--              <h6>Steps</h6>-->
              <%#= phase_form.fields_for :experiment_steps do |step_form| %>
<!--                <div class="mb-2">-->
                  <%#= step_form.number_field :step_number, class: "form-control mb-1", placeholder: "Step No" %>
                  <%#= step_form.text_field :instruction, class: "form-control", placeholder: "Instruction" %>
<!--                </div>-->
              <%# end %>

<!--              <button type="button" class="btn btn-sm btn-danger remove-phase">Remove Phase</button>-->
<!--            </div>-->
          <%# end %>
<!--        </div>-->

<!--        <button type="button" id="add-phase" class="btn btn-outline-secondary btn-sm">-->
<!--          + Add Phase-->
<!--        </button>-->


        <%= f.submit @experiment.new_record? ? "Create Experiment" : "Update Experiment", class: "btn btn-primary w-100 fw-semibold" %>
      <% end %>
    </div>
  </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const phasesWrapper = document.getElementById("phases-wrapper");
        const addPhaseBtn = document.getElementById("add-phase");

        let phaseIndex = phasesWrapper.children.length;

        // ADD PHASE
        addPhaseBtn.addEventListener("click", function () {

            const phaseHTML = `
      <div class="card p-3 mb-3 phase-card">

        <div class="d-flex justify-content-between mb-2">
          <h6 class="fw-bold">Phase</h6>
          <button type="button" class="btn btn-sm btn-danger remove-phase">
            Remove
          </button>
        </div>

        <input type="text"
        name="experiment[experiment_phases_attributes][${phaseIndex}][title]"
        class="form-control mb-2"
        placeholder="Phase Title">

        <textarea
        name="experiment[experiment_phases_attributes][${phaseIndex}][description]"
        class="form-control mb-3"
        placeholder="Phase Description"></textarea>

        <h6>Steps</h6>

        <div class="phase-steps-wrapper"></div>

        <button type="button"
        class="btn btn-sm btn-outline-primary add-step">
        + Add Step
        </button>

      </div>
    `;

            phasesWrapper.insertAdjacentHTML("beforeend", phaseHTML);

            phaseIndex++;
        });


        // DELEGATION EVENTS
        phasesWrapper.addEventListener("click", function(e){

            // REMOVE PHASE
            if(e.target.classList.contains("remove-phase")){

                e.target.closest(".phase-card").remove();
            }


            // ADD STEP
            if(e.target.classList.contains("add-step")){

                const phaseCard = e.target.closest(".phase-card");
                const stepsWrapper = phaseCard.querySelector(".phase-steps-wrapper");

                const phasePosition =
                    Array.from(phasesWrapper.children).indexOf(phaseCard);

                const stepIndex = stepsWrapper.children.length;

                const stepHTML = `
        <div class="step-item border rounded p-2 mb-2 bg-light">

          <input type="number"
          name="experiment[experiment_phases_attributes][${phasePosition}][phase_steps_attributes][${stepIndex}][step_number]"
          class="form-control mb-1"
          placeholder="Step Number">

          <textarea
          name="experiment[experiment_phases_attributes][${phasePosition}][phase_steps_attributes][${stepIndex}][instruction]"
          class="form-control mb-2"
          rows="2"
          placeholder="Step Instruction"></textarea>

          <button type="button"
          class="btn btn-sm btn-outline-danger remove-step">
          Remove Step
          </button>

        </div>
      `;

                stepsWrapper.insertAdjacentHTML("beforeend", stepHTML);
            }


            // REMOVE STEP
            if(e.target.classList.contains("remove-step")){

                e.target.closest(".step-item").remove();
            }

        });

    });
</script>