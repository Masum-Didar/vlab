<% content_for :title, "Edit DNA Band - #{@config.sample_name}" %>

<header class="admin-page-head">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2 small">
        <li class="breadcrumb-item"><%= link_to "Experiments", admin_experiments_path %></li>
        <li class="breadcrumb-item"><%= link_to @experiment.title, admin_experiment_path(@experiment) %></li>
        <li class="breadcrumb-item"><%= link_to "DNA Bands", admin_experiment_dna_band_configs_path(@experiment) %></li>
        <li class="breadcrumb-item active"><%= @config.sample_name %></li>
      </ol>
    </nav>
    <h1>Edit: <%= @config.sample_name %></h1>
  </div>
</header>

<%= form_with model: @config, url: admin_experiment_dna_band_config_path(@experiment, @config), method: :patch, class: "admin-panel", local: true do |f| %>
  <% if @config.errors.any? %>
    <div class="alert alert-danger">
      <%= @config.errors.full_messages.join(", ") %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :well_number, class: "form-label fw-semibold" %>
    <%= f.number_field :well_number, min: 1, max: 12, class: "form-control", style: "max-width: 8rem;", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :sample_name, class: "form-label fw-semibold" %>
    <%= f.text_field :sample_name, class: "form-control", style: "max-width: 20rem;", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :band_positions, "Band positions (comma separated)", class: "form-label fw-semibold" %>
    <%= f.text_field :band_positions, value: Array(f.object.band_positions).join(", "), class: "form-control", style: "max-width: 20rem;", placeholder: "e.g. 45, 78" %>
  </div>

  <div class="mb-3">
    <%= f.label :correct_genotype, class: "form-label fw-semibold" %>
    <%= f.text_field :correct_genotype, class: "form-control", style: "max-width: 16rem;", placeholder: "e.g. Genotype-1" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Update", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_experiment_dna_band_configs_path(@experiment), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
