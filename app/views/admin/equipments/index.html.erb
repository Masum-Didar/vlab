<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Equipments</h2>
  <%= link_to "Add Chemical", new_admin_equipment_path, class: "btn btn-primary" %>
</div>

<table class="table table-bordered">
  <thead>
  <tr>
    <th>Name</th>
    <th>Formula</th>
    <th></th>
  </tr>
  </thead>
  <tbody>
  <% @equipments.each do |equipment| %>
    <tr>
      <td><%= equipment.name %></td>
      <td><%= equipment.formula %></td>
      <td class="text-end">
        <%= link_to "Edit", edit_admin_equipment_path(equipment), class: "btn btn-sm btn-outline-primary" %>
        <%= link_to "Delete", admin_equipment_path(equipment),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                    class: "btn btn-sm btn-outline-danger" %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>