<%= form_with model: [:admin, @equipment], class: "d-flex flex-column gap-3" do |f| %>
  <div>
    <%= f.label :name, class: "form-label fw-medium" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div>
    <%= f.label :description, class: "form-label fw-medium" %>
    <%= f.text_area :description, rows: 3, class: "form-control" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>