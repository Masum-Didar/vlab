<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <h2><%= @equipment.name %></h2>
    <p class="text-body-secondary mb-0"><%= @equipment.equipment_type.presence || "No equipment type" %></p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_admin_equipment_path(@equipment), class: "btn btn-primary" %>
    <%= link_to "Back", admin_equipments_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="row g-4">
  <div class="col-md-4">
    <% if @equipment.image.attached? %>
      <%= image_tag @equipment.image, alt: @equipment.name, class: "img-fluid rounded border" %>
    <% else %>
      <div class="border rounded p-4 text-body-secondary text-center">No image uploaded.</div>
    <% end %>
  </div>
  <div class="col-md-8">
    <div class="card border">
      <div class="card-body">
        <h3 class="h5">Description</h3>
        <p class="mb-0"><%= @equipment.description.presence || "No description added." %></p>
      </div>
    </div>
  </div>
</div>
