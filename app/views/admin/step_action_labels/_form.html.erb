<%= form_with model: step_action_label,
              url: admin_step_action_step_action_labels_path(step_action),
              local: true do |f| %>

  <div class="mb-3">
    <%= f.label :label_text, "Label text" %>
    <%= f.text_field :label_text, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :image_url, "Reference image URL" %>
    <%= f.text_field :image_url, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :equipment_id, "Associated Equipment (for drag & drop)" %>
    <%= f.collection_select :equipment_id, Equipment.order(:name), :id, :name, { prompt: "Select associated equipment..." }, class: "form-select" %>
  </div>

  <div class="row g-2">
    <div class="col-md-6">
      <%= f.label :position %>
      <%= f.number_field :position, class: "form-control", min: 1 %>
    </div>
    <div class="col-md-6 d-flex align-items-end">
      <div class="form-check">
        <%= f.check_box :correct_match, class: "form-check-input" %>
        <%= f.label :correct_match, "Correct match", class: "form-check-label" %>
      </div>
    </div>
  </div>

  <div class="modal-footer">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
    <%= f.submit "Save Label", class: "btn btn-primary" %>
  </div>

<% end %>
