<% if @step_action.step_action_labels.any? %>
  <table class="table table-sm table-bordered">
    <thead class="table-light">
    <tr>
      <th>#</th>
      <th>Label</th>
      <th>Associated Equipment</th>
      <th>Correct</th>
    </tr>
    </thead>
    <tbody>
    <% @step_action.step_action_labels.each_with_index do |label, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= label.label_text %></td>
        <td>
          <% if label.equipment %>
            <%= label.equipment.name %>
            <% if label.equipment.image.attached? %>
              <span class="badge bg-success ms-1">Image Attached</span>
            <% else %>
              <span class="badge bg-warning text-dark ms-1">No Image</span>
            <% end %>
          <% else %>
            <span class="text-muted small">None</span>
          <% end %>
        </td>
        <td><%= label.correct_match? ? "Yes" : "No" %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted small mb-0">No labels added yet.</p>
<% end %>
