<% if @step_action.step_action_labels.any? %>
  <table class="table table-sm table-bordered">
    <thead class="table-light">
    <tr>
      <th>#</th>
      <th>Name</th>
      <th>Correct Equipment</th>
    </tr>
    </thead>
    <tbody>
    <% @step_action.step_action_labels.each_with_index do |label, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= label.name %></td>
        <td><%= label.correct_equipment.presence || "-" %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted small mb-0">No labels added yet.</p>
<% end %>