<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Global Containers</h2>
  <%= link_to "Add Container", new_super_admin_container_path, class: "btn btn-danger" %>
</div>

<table class="table table-bordered bg-white">
  <thead>
  <tr>
    <th>Name</th>
    <th>Type</th>
    <th></th>
  </tr>
  </thead>
  <tbody>
  <% @containers.each do |container| %>
    <tr>
      <td><strong><%= container.name %></strong></td>
      <td><span class="badge bg-light text-dark border"><%= container.container_type&.titleize %></span></td>
      <td class="text-end">
        <%= link_to "Edit", edit_super_admin_container_path(container), class: "btn btn-sm btn-outline-primary" %>
        <%= link_to "Delete", super_admin_container_path(container),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                    class: "btn btn-sm btn-outline-danger" %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
