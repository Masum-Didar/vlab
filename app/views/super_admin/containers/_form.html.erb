<% form_url = @container.persisted? ? super_admin_container_path(@container) : super_admin_containers_path %>

<%= form_with model: @container, url: form_url, class: "d-flex flex-column gap-3 bg-white p-4 border rounded", local: true do |f| %>
  <% if @container.errors.any? %>
    <div class="alert alert-danger">
      <strong>Please fix <%= pluralize(@container.errors.count, "issue") %>.</strong>
      <ul class="mb-0 mt-2">
        <% @container.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "form-label fw-semibold" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div>
    <%= f.label :container_type, "Container Type", class: "form-label fw-semibold" %>
    <%= f.select :container_type, [["Flask", "flask"], ["Graduated Cylinder", "graduated_cylinder"], ["Tray", "tray"], ["Tube", "tube"], ["Well", "well"], ["Waste", "waste"], ["General", "general"]], { prompt: "Select container type" }, class: "form-select" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-danger" %>
    <%= link_to "Cancel", super_admin_containers_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
