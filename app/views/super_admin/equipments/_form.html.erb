<% form_url = @equipment.persisted? ? super_admin_equipment_path(@equipment) : super_admin_equipments_path %>

<%= form_with model: @equipment, url: form_url, class: "d-flex flex-column gap-3 bg-white p-4 border rounded", local: true do |f| %>
  <% if @equipment.errors.any? %>
    <div class="alert alert-danger">
      <strong>Please fix <%= pluralize(@equipment.errors.count, "issue") %>.</strong>
      <ul class="mb-0 mt-2">
        <% @equipment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "form-label fw-semibold" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div>
    <%= f.label :equipment_type, "Equipment type", class: "form-label fw-semibold" %>
    <%= f.text_field :equipment_type, class: "form-control", placeholder: "Microscope, pipette, beaker" %>
  </div>

  <div>
    <%= f.label :description, class: "form-label fw-semibold" %>
    <%= f.text_area :description, rows: 3, class: "form-control" %>
  </div>

  <div>
    <%= f.label :image, "Equipment image", class: "form-label fw-semibold" %>
    <%= f.file_field :image, accept: "image/png,image/jpeg,image/webp,image/gif", class: "form-control" %>
    <% if @equipment.image.attached? %>
      <div class="mt-2">
        <%= image_tag @equipment.image, alt: @equipment.name, class: "img-thumbnail", style: "max-width: 180px; max-height: 140px;" %>
      </div>
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-danger" %>
    <%= link_to "Cancel", super_admin_equipments_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
