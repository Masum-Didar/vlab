<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Global Equipments</h2>
  <%= link_to "Add Equipment", new_super_admin_equipment_path, class: "btn btn-danger" %>
</div>

<table class="table table-bordered bg-white">
  <thead>
  <tr>
    <th>Image</th>
    <th>Name</th>
    <th>Type</th>
    <th>Description</th>
    <th></th>
  </tr>
  </thead>
  <tbody>
  <% @equipments.each do |equipment| %>
    <tr>
      <td style="width: 96px;">
        <% if equipment.image.attached? %>
          <%= image_tag equipment.image, alt: equipment.name, class: "img-thumbnail", style: "width: 72px; height: 56px; object-fit: cover;" %>
        <% else %>
          <span class="text-body-secondary small">No image</span>
        <% end %>
      </td>
      <td><%= equipment.name %></td>
      <td><%= equipment.equipment_type.presence || "-" %></td>
      <td><%= truncate(equipment.description, length: 80) %></td>
      <td class="text-end">
        <%= link_to "Edit", edit_super_admin_equipment_path(equipment), class: "btn btn-sm btn-outline-primary" %>
        <%= link_to "Delete", super_admin_equipment_path(equipment),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                    class: "btn btn-sm btn-outline-danger" %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
