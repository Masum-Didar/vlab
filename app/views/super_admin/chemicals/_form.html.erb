<% form_url = @chemical.persisted? ? super_admin_chemical_path(@chemical) : super_admin_chemicals_path %>

<%= form_with model: @chemical, url: form_url, class: "d-flex flex-column gap-3 bg-white p-4 border rounded", local: true do |f| %>
  <% if @chemical.errors.any? %>
    <div class="alert alert-danger">
      <strong>Please fix <%= pluralize(@chemical.errors.count, "issue") %>.</strong>
      <ul class="mb-0 mt-2">
        <% @chemical.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "form-label fw-semibold" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div>
    <%= f.label :formula, class: "form-label fw-semibold" %>
    <%= f.text_field :formula, class: "form-control", placeholder: "H2O, NaCl" %>
  </div>

  <div>
    <%= f.label :state, "State", class: "form-label fw-semibold" %>
    <%= f.select :state, [["Solid", "solid"], ["Liquid", "liquid"], ["Gas", "gas"]], { prompt: "Select chemical state" }, class: "form-select" %>
  </div>

  <div>
    <%= f.label :description, class: "form-label fw-semibold" %>
    <%= f.text_area :description, rows: 3, class: "form-control" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-danger" %>
    <%= link_to "Cancel", super_admin_chemicals_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
