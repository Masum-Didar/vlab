<% content_for :title, "Schools" %>

<header class="admin-page-head">
  <div>
    <h1>Schools</h1>
    <p>Manage all registered schools and their experiment access.</p>
  </div>
</header>

<section class="admin-table-card">
  <% if @schools.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>School</th>
            <th>Subdomain</th>
            <th>Admins</th>
            <th>Students</th>
            <th>Experiments</th>
            <th class="text-end"></th>
          </tr>
        </thead>
        <tbody>
          <% @schools.each do |school| %>
            <tr>
              <td><strong><%= school.name %></strong></td>
              <td><code><%= school.subdomain %>.lvh.me</code></td>
              <td><%= school.users.where(role: :administrator).count %></td>
              <td><%= school.users.where(role: :student).count %></td>
              <td><%= school.experiment_schools.count %></td>
              <td class="text-end">
                <%= link_to "Manage", super_admin_school_path(school), class: "btn btn-outline-primary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty">
      <h2>No schools registered</h2>
      <p>Schools appear here when they register through the landing page.</p>
    </div>
  <% end %>
</section>
